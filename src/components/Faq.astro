---
import Icon from './Icon.astro';
import SpaceBanner from './SpaceBanner.astro';

const faqs = [
  {
    q: 'How does authkestra-mcp secure AI agents and Model Context Protocol servers?',
    a: 'Three tiers: public, scoped (OAuth 2.1 / DPoP), and human-approved with passkey step-up. Third-party credentials stay in a server-side vault, out of the model context.',
  },
  {
    q: 'How does Authkestra prevent AI agents from tampering with approved tool parameters?',
    a: 'Arguments are canonicalized (RFC 8785) and hashed with SHA-256. If a single value changes before execution, the digest check fails and the call is aborted.',
  },
  {
    q: 'When should I choose an embedded engine like Authkestra vs. Keycloak, Ory, or Zitadel?',
    a: 'Choose Authkestra for in-process auth in Rust services with no sidecar. Choose Keycloak, Zitadel, or Ory for admin GUIs, SAML, or workforce SSO. You can connect them via OIDC.',
  },
  {
    q: 'What is Re-Proof Gating and how does it prevent session escalation?',
    a: 'Enrolling a new passkey or TOTP requires re-proving an existing factor within a short window, so a stolen session cookie cannot lock out the owner.',
  },
  {
    q: 'How does Stateless OAuth work without storing sessions in a database?',
    a: 'OAuth state and PKCE verifiers live in AES-256-GCM encrypted cookies, so you scale horizontally with no Redis or SQL session store.',
  },
  {
    q: 'How do AI coding assistants discover Authkestra APIs via llms.txt and Agent Skills?',
    a: 'Authkestra publishes llms.txt and agent skills that teach assistants the builder rules, feature flags, and storage traits.',
  },
  {
    q: 'Can I use Authkestra with any database or web framework?',
    a: 'Yes. The core is framework-free, with Axum and Actix-web adapters and in-memory, Redis, and SQL stores.',
  },
];
---
<section id="faq" class="faq" aria-labelledby="faq-heading">
  <div class="inner">
    <div class="faq-layout">
      <div class="header">
        <span class="eyebrow">ARCHITECTURE &amp; OPERATIONS</span>
        <h2 id="faq-heading">Frequently Asked Questions</h2>
        <p class="lead">
          Short answers on architecture and agent security.
        </p>
        <SpaceBanner src="/space/faq-starfield.webp" class="faq-banner" />
        <div class="faq-links">
          <a href="https://docs.authkestra.com" target="_blank" rel="noopener noreferrer">
            <span>Read Full Documentation</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href="https://github.com/Authkestra/authkestra/blob/main/SECURITY.md" target="_blank" rel="noopener noreferrer">
            <span>Security Policy &amp; Disclosure</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href="https://play.authkestra.com" target="_blank" rel="noopener noreferrer">
            <span>Try Interactive Playground</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="faq-list">
        {faqs.map((item, idx) => (
          <details class="faq-item" open={idx === 0}>
            <summary class="faq-summary">
              <h3>{item.q}</h3>
              <div class="chevron-wrap">
                <Icon name="chevron-down" size={18} class="chevron" aria-hidden="true" />
              </div>
            </summary>
            <div class="faq-answer">
              <p>{item.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .faq {
    max-width: var(--ak-layout-max);
    margin: 0 auto;
    padding: var(--ak-space-24) var(--ak-space-6);
  }

  .inner {
    position: relative;
  }

  .faq-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.4fr) minmax(0, 0.6fr);
    gap: var(--ak-space-12);
    align-items: start;
  }

  .header {
    position: sticky;
    top: 6rem;
  }

  .eyebrow {
    display: inline-block;
    font-size: var(--ak-text-xs);
    font-family: var(--ak-font-mono);
    font-weight: 600;
    color: hsl(var(--primary-accent));
    letter-spacing: var(--ak-tracking-wide);
    margin-bottom: var(--ak-space-3);
  }

  h2 {
    font-size: var(--ak-text-3xl);
    letter-spacing: var(--ak-tracking-tight);
    color: hsl(var(--foreground));
  }

  .lead {
    margin-top: var(--ak-space-4);
    font-size: var(--ak-text-lg);
    line-height: var(--ak-leading-relaxed);
    color: hsl(var(--ak-neutral-300));
  }

  .faq-links {
    margin-top: var(--ak-space-6);
    display: flex;
    flex-direction: column;
    gap: var(--ak-space-3);
    padding-top: var(--ak-space-6);
    border-top: 1px solid hsl(var(--border));
  }

  .faq-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--ak-space-2);
    font-size: var(--ak-text-sm);
    font-weight: 500;
    color: hsl(var(--primary-accent));
    text-decoration: none;
  }

  .faq-links a:hover {
    text-decoration: underline;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--ak-space-4);
  }

  .faq-item {
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color var(--ak-duration-fast) var(--ak-ease-out);
  }

  .faq-item:hover {
    border-color: hsl(var(--input));
  }

  .faq-item[open] {
    border-color: hsl(var(--input));
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ak-space-4);
    padding: var(--ak-space-5) var(--ak-space-6);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-summary h3 {
    font-size: var(--ak-text-base);
    font-weight: 600;
    color: hsl(var(--foreground));
    margin: 0;
    line-height: var(--ak-leading-snug);
  }

  .chevron-wrap {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--ak-radius-sm);
    background: hsl(var(--ak-neutral-800));
    color: hsl(var(--ak-neutral-300));
    transition: transform var(--ak-duration-fast) var(--ak-ease-out), color var(--ak-duration-fast) var(--ak-ease-out);
  }

  .faq-summary:hover .chevron-wrap {
    color: hsl(var(--primary-accent));
  }

  .faq-item[open] .chevron-wrap {
    transform: rotate(180deg);
    color: hsl(var(--primary-accent));
  }

  .faq-answer {
    padding: 0 var(--ak-space-6) var(--ak-space-6);
  }

  .faq-answer p {
    font-size: var(--ak-text-sm);
    line-height: var(--ak-leading-relaxed);
    color: hsl(var(--ak-neutral-300));
    margin: 0;
  }

  @media (max-width: 960px) {
    .faq-layout {
      grid-template-columns: 1fr;
      gap: var(--ak-space-8);
    }
    .header {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .faq {
      padding: var(--ak-space-16) var(--ak-space-4);
    }
    .faq-summary {
      padding: var(--ak-space-4);
    }
    .faq-answer {
      padding: 0 var(--ak-space-4) var(--ak-space-4);
    }
  }
</style>
