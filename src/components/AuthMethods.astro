---
import Icon from './Icon.astro';

const clientMethods = [
  {
    icon: 'fingerprint',
    title: 'Passkeys (WebAuthn)',
    body: 'Phishing-resistant sign-in backed by platform authenticators with re-proof enrolment gating.',
    href: 'https://docs.authkestra.com/providers/passkeys/',
  },
  {
    icon: 'smartphone',
    title: 'TOTP (authenticator apps)',
    body: 'Time-based one-time codes for a second factor, enrolled and verified against your own store.',
    href: 'https://docs.authkestra.com/providers/totp/',
  },
  {
    icon: 'link',
    title: 'Magic link',
    body: 'A single-use link minted server-side with AtomicConsume — guaranteed single redemption.',
    href: 'https://docs.authkestra.com/providers/magic-link/',
  },
  {
    icon: 'message-square-code',
    title: 'Email / SMS one-time codes',
    body: 'Short numeric codes with real attempt budgets (AtomicDecrement) and resend rate limits.',
    href: 'https://docs.authkestra.com/providers/otp/',
  },
  {
    icon: 'list-checks',
    title: 'Recovery codes',
    body: 'Look-up secret authenticators (NIST SP 800-63B) hashed with Argon2id and re-proof protected.',
    href: 'https://docs.authkestra.com/providers/recovery-codes/',
  },
  {
    icon: 'key-round',
    title: 'Stateless OAuth2',
    body: 'Social sign-in with the OAuth dance handled in AES-256-GCM cookies — zero DB session overhead.',
    href: 'https://docs.authkestra.com/providers/oauth2/',
  },
  {
    icon: 'id-card',
    title: 'OIDC provider (client)',
    body: 'Verify identity against any OpenID Connect provider using discovery and cached signing keys.',
    href: 'https://docs.authkestra.com/providers/oidc/',
  },
  {
    icon: 'server',
    title: 'Client credentials',
    body: 'Machine-to-machine authentication with private_key_jwt (RFC 7523) for backend microservices.',
    href: 'https://docs.authkestra.com/providers/client-credentials/',
  },
  {
    icon: 'tv-minimal',
    title: 'Device flow',
    body: 'RFC 8628 device authorization grant for TVs, CLI utilities, and headless environments.',
    href: 'https://docs.authkestra.com/providers/device-flow/',
  },
  {
    icon: 'shield-check',
    title: 'Bot protection (CAPTCHA)',
    body: 'Challenge suspect traffic with Cloudflare Turnstile or hCaptcha before hitting auth logic.',
    href: 'https://docs.authkestra.com/providers/bot-protection/',
  },
  {
    icon: 'badge-check',
    title: 'Device signatures',
    body: 'Cryptographic proof-of-possession and body digest hashing (bdh) via authkestra-devsig.',
    href: 'https://docs.authkestra.com/providers/device-signatures/',
  },
];

const serverRoles = [
  {
    icon: 'bot',
    title: 'MCP Server Security (authkestra-mcp)',
    badge: 'AI Agents',
    body: 'Three security tiers (Public, Scoped, HumanApproved), JCS parameter binding, and zero-trust downstream vault.',
    href: 'https://docs.authkestra.com/guides/ai-agents/',
  },
  {
    icon: 'server',
    title: 'Full OpenID Provider (authkestra-op)',
    badge: 'IdP Server',
    body: 'Full embedded OIDC Provider with RFC 8693 Token Exchange, Device Flow, JWKS rotation, and client registration.',
    href: 'https://docs.authkestra.com/advanced/op-server/',
  },
  {
    icon: 'shield',
    title: 'Resource Server Guard (authkestra-resource)',
    badge: 'API Edge',
    body: 'Validate JWTs/tokens with RFC 9449 DPoP, RFC 8705 mTLS binding, multi-issuer JWKS, and scope enforcement.',
    href: 'https://docs.authkestra.com/advanced/resource-server/',
  },
  {
    icon: 'layers',
    title: 'AWS Cedar Policy Engine (authkestra-policy)',
    badge: 'Authorization',
    body: 'High-performance declarative attribute-based access control (ABAC) evaluated in-process in microseconds.',
    href: 'https://docs.authkestra.com/advanced/policy-engine/',
  },
  {
    icon: 'radio',
    title: 'Continuous Access Evaluation (authkestra-ssf)',
    badge: 'Zero-Trust',
    body: 'Ingest OpenID Shared Signals & Events (CAEP/SSF RFC 8417) to terminate sessions and revoke tokens in real time.',
    href: 'https://docs.authkestra.com/advanced/continuous-access-evaluation/',
  },
];
---
<section id="methods" class="methods" aria-labelledby="methods-heading">
  <div class="inner">
    <h2 id="methods-heading">Authentication Methods &amp; Server Roles</h2>
    <p class="lead">
      Each client method and server capability is a composable component in the same engine.
      Mix them, chain them, or embed them into an existing API — your core code architecture stays unchanged.
    </p>

    <!-- Part 1: Client Strategies -->
    <div class="sub-section">
      <div class="sub-header">
        <span class="sub-tag">CLIENT AUTHENTICATION</span>
        <p class="sub-lead">11 strategies to prove identity and authenticate users or devices:</p>
      </div>
      <ul class="grid client-grid">
        {clientMethods.map((m) => (
          <li>
            <a class="card" href={m.href} target="_blank" rel="noopener noreferrer">
              <Icon name={m.icon} size={24} class="icon" aria-hidden="true" />
              <h3>{m.title}</h3>
              <p>{m.body}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Part 2: Enterprise Server Roles -->
    <div class="sub-section roles-section">
      <div class="sub-header">
        <span class="sub-tag">ENTERPRISE SERVER ROLES</span>
        <p class="sub-lead">5 embedded server engines to protect APIs, issue tokens, and enforce policy:</p>
      </div>
      <ul class="grid roles-grid">
        {serverRoles.map((r) => (
          <li>
            <a class="card role-card" href={r.href} target="_blank" rel="noopener noreferrer">
              <div class="role-top">
                <Icon name={r.icon} size={24} class="icon" aria-hidden="true" />
                <span class="role-badge">{r.badge}</span>
              </div>
              <h3>{r.title}</h3>
              <p>{r.body}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .methods {
    max-width: var(--ak-layout-max);
    margin: 0 auto;
    padding: var(--ak-space-24) var(--ak-space-6);
  }

  .inner {
    position: relative;
  }

  h2 {
    font-size: var(--ak-text-3xl);
    letter-spacing: var(--ak-tracking-tight);
    color: hsl(var(--foreground));
  }

  .lead {
    margin-top: var(--ak-space-4);
    max-width: 68ch;
    font-size: var(--ak-text-lg);
    line-height: var(--ak-leading-relaxed);
    color: hsl(var(--muted-foreground));
  }

  .sub-section {
    margin-top: var(--ak-space-12);
  }

  .roles-section {
    margin-top: var(--ak-space-16);
    padding-top: var(--ak-space-12);
    border-top: 1px solid hsl(var(--border));
  }

  .sub-header {
    margin-bottom: var(--ak-space-6);
  }

  .sub-tag {
    display: inline-block;
    font-size: var(--ak-text-2xs);
    font-family: var(--ak-font-mono);
    font-weight: 600;
    color: hsl(var(--primary-accent));
    letter-spacing: var(--ak-tracking-wide);
  }

  .sub-lead {
    margin-top: var(--ak-space-1);
    font-size: var(--ak-text-sm);
    color: hsl(var(--muted-foreground));
  }

  .grid {
    display: grid;
    gap: var(--ak-space-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .client-grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .roles-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    padding: var(--ak-space-5);
    text-decoration: none;
    transition: all var(--ak-duration-fast) var(--ak-ease-out);
  }

  .card:hover {
    border-color: hsl(var(--input));
    background: hsl(var(--popover));
  }

  .role-card {
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
  }

  .role-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .role-badge {
    font-size: var(--ak-text-2xs);
    font-family: var(--ak-font-mono);
    padding: 2px 8px;
    border-radius: var(--ak-radius-sm);
    background: hsl(var(--ak-neutral-800));
    color: hsl(var(--primary-accent));
    border: 1px solid hsl(var(--border));
  }

  .icon {
    color: hsl(var(--primary-accent));
  }

  h3 {
    margin-top: var(--ak-space-3);
    font-size: var(--ak-text-sm);
    font-weight: 600;
    color: hsl(var(--foreground));
  }

  .card p {
    margin-top: var(--ak-space-2);
    font-size: var(--ak-text-xs);
    color: hsl(var(--muted-foreground));
    line-height: var(--ak-leading-normal);
  }

  @media (max-width: 1080px) {
    .client-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .roles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .client-grid,
    .roles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .methods {
      padding: var(--ak-space-16) var(--ak-space-4);
    }
    .client-grid,
    .roles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
