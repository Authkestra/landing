---
import Icon from './Icon.astro';
---
<section class="hero" id="top">
  <div class="grid-texture" aria-hidden="true"></div>
  <div class="inner">
    <div class="hero-copy">
      <a href="#security-posture" class="posture">v0.13, pre-1.0. Read the security posture</a>

      <h1>Your Authz system shouldn't be allucinated</h1>
      <p class="lead">
        The compile-time safe auth engine for Rust. Enforce interactive human passkeys,
        MCP step-up protocols, and tamper-proof canonical digests - without running a sidecar.
      </p>

      <div class="ctas">
        <a class="btn primary" href="#quickstart">Quickstart</a>
        <a class="btn secondary" href="https://docs.authkestra.com">Documentation</a>
        <a class="btn ghost" href="https://play.authkestra.com" target="_blank" rel="noopener noreferrer">Playground</a>
      </div>

      <div class="install">
        <span class="prompt" aria-hidden="true">$</span>
        <code class="cmd">cargo add authkestra</code>
        <button class="copy-btn" id="hero-copy-btn" aria-label="Copy install command" title="Copy install command">
          <Icon name="copy" size={16} class="copy-icon" aria-hidden="true" />
          <Icon name="check" size={16} class="check-icon visually-hidden" aria-hidden="true" />
          <span class="copy-label">Copy</span>
        </button>
      </div>
    </div>

    <div class="demo-showcase">
      <div class="showcase-header">
        <div class="window-controls" aria-hidden="true">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
        </div>
        <div class="window-title">
          <Icon name="bot" size={13} class="window-icon" aria-hidden="true" />
          <span>play.authkestra.com - Tier 3 MCP Policy</span>
        </div>
        <div class="live-badge">
          <span class="live-dot" aria-hidden="true"></span>
          <span>LIVE RECORDING</span>
        </div>
      </div>
      <div class="video-container">
        <video
          autoplay
          loop
          muted
          playsinline
          poster="/mcp-demo-poster.png"
          width="780"
          height="720"
          aria-label="Interactive demonstration of Authkestra MCP Protocol Step-Up and parameter anti-tampering enforcement"
        >
          <source src="/mcp-demo.webm" type="video/webm" />
          <source src="/mcp-demo.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="showcase-footer">
        <div class="footer-step">
          <span class="step-num">1</span>
          <span class="step-txt">Error -32001 Step-Up</span>
        </div>
        <div class="footer-arrow" aria-hidden="true">&rarr;</div>
        <div class="footer-step">
          <span class="step-num">2</span>
          <span class="step-txt">Biometric Passkey</span>
        </div>
        <div class="footer-arrow" aria-hidden="true">&rarr;</div>
        <div class="footer-step blocked">
          <Icon name="shield-alert" size={13} aria-hidden="true" />
          <span class="step-txt">Tampering Blocked</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('hero-copy-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('cargo add authkestra');
        const copyIcon = copyBtn.querySelector('.copy-icon');
        const checkIcon = copyBtn.querySelector('.check-icon');
        const label = copyBtn.querySelector('.copy-label');
        if (copyIcon && checkIcon && label) {
          copyIcon.classList.add('visually-hidden');
          checkIcon.classList.remove('visually-hidden');
          label.textContent = 'Copied';
          setTimeout(() => {
            copyIcon.classList.remove('visually-hidden');
            checkIcon.classList.add('visually-hidden');
            label.textContent = 'Copy';
          }, 2000);
        }
      } catch (err) {
        console.error('Failed to copy to clipboard', err);
      }
    });
  }
</script>

<style>
  .hero {
    position: relative;
    max-width: var(--ak-layout-max);
    margin: 0 auto;
    padding: var(--ak-space-16) var(--ak-space-6) var(--ak-space-16);
    overflow: hidden;
  }

  .grid-texture {
    position: absolute;
    inset: -10% -10% auto -10%;
    height: 520px;
    background-image:
      linear-gradient(hsl(var(--border) / 0.5) 1px, transparent 1px),
      linear-gradient(90deg, hsl(var(--border) / 0.5) 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 0%, black 40%, transparent 80%);
    mask-image: radial-gradient(ellipse 75% 65% at 50% 0%, black 40%, transparent 80%);
    pointer-events: none;
  }

  .inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--ak-space-12);
    align-items: center;
  }

  .hero-copy,
  .demo-showcase {
    min-width: 0;
  }

  .posture {
    display: inline-block;
    margin-bottom: var(--ak-space-5);
    font-size: var(--ak-text-sm);
    color: hsl(var(--primary-accent));
  }

  .posture:hover {
    text-decoration: underline;
  }

  h1 {
    font-size: var(--ak-text-4xl);
    line-height: var(--ak-leading-tight);
    letter-spacing: var(--ak-tracking-tight);
    max-width: 22ch;
    text-wrap: balance;
  }

  .lead {
    margin-top: var(--ak-space-5);
    max-width: 46ch;
    font-size: var(--ak-text-lg);
    line-height: var(--ak-leading-relaxed);
    color: hsl(var(--ak-neutral-300));
  }

  .ctas {
    margin-top: var(--ak-space-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--ak-space-3);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 var(--ak-space-5);
    border-radius: var(--radius);
    font-size: var(--ak-text-sm);
    font-weight: 500;
    transition: all var(--ak-duration-fast) var(--ak-ease-out);
  }

  .btn.primary {
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    box-shadow: var(--ak-shadow-accent);
  }

  .btn.primary:hover { filter: brightness(1.08); }

  .btn.secondary {
    background: hsl(var(--card));
    color: hsl(var(--foreground));
    border: 1px solid hsl(var(--border));
  }

  .btn.secondary:hover { border-color: hsl(var(--input)); }

  .btn.ghost {
    color: hsl(var(--ak-neutral-300));
  }

  .btn.ghost:hover { color: hsl(var(--foreground)); }

  .install {
    margin-top: var(--ak-space-6);
    max-width: 420px;
    display: flex;
    align-items: center;
    gap: var(--ak-space-3);
    padding: var(--ak-space-2) var(--ak-space-2) var(--ak-space-2) var(--ak-space-4);
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--ak-radius-md);
    font-family: var(--ak-font-mono);
    font-size: var(--ak-text-sm);
  }

  .prompt {
    color: hsl(var(--primary-accent));
    user-select: none;
  }

  .cmd {
    flex: 1;
    color: hsl(var(--foreground));
    font: inherit;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--ak-space-2);
    background: hsl(var(--muted));
    border: 1px solid hsl(var(--border));
    border-radius: var(--ak-radius-sm);
    color: hsl(var(--ak-neutral-300));
    padding: var(--ak-space-1) var(--ak-space-3);
    font-size: var(--ak-text-xs);
    font-family: var(--ak-font-sans);
  }

  .copy-btn:hover {
    color: hsl(var(--foreground));
    border-color: hsl(var(--input));
  }

  .copy-btn :global(.check-icon) {
    color: hsl(var(--success-foreground));
  }

  /* Live MCP Playground Demo Showcase Frame */
  .demo-showcase {
    position: relative;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--ak-radius-xl);
    box-shadow: 0 20px 45px -15px rgba(0, 0, 0, 0.7), 0 0 0 1px hsl(var(--border) / 0.5);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .showcase-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ak-space-3);
    padding: var(--ak-space-3) var(--ak-space-4);
    background: hsl(var(--ak-neutral-950));
    border-bottom: 1px solid hsl(var(--border));
  }

  .window-controls {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 60px;
  }

  .window-controls .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .dot.red { background: #ef4444; opacity: 0.85; }
  .dot.yellow { background: #eab308; opacity: 0.85; }
  .dot.green { background: #22c55e; opacity: 0.85; }

  .window-title {
    display: flex;
    align-items: center;
    gap: var(--ak-space-2);
    font-family: var(--ak-font-mono);
    font-size: var(--ak-text-xs);
    color: hsl(var(--muted-foreground));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .window-icon {
    color: hsl(var(--primary-accent));
    shrink: 0;
  }

  .live-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 7px;
    border-radius: var(--ak-radius-full);
    background: hsl(var(--success) / 0.12);
    border: 1px solid hsl(var(--success-foreground) / 0.25);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: hsl(var(--success-foreground));
    white-space: nowrap;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: hsl(var(--success-foreground));
    box-shadow: 0 0 6px hsl(var(--success-foreground));
    animation: pulse-glow 2.5s infinite ease-in-out;
  }

  @keyframes pulse-glow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .video-container {
    position: relative;
    width: 100%;
    background: #09090b;
    overflow: hidden;
    line-height: 0;
  }

  .video-container video {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .showcase-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ak-space-2);
    padding: var(--ak-space-3) var(--ak-space-4);
    background: hsl(var(--ak-neutral-950));
    border-top: 1px solid hsl(var(--border));
    font-size: var(--ak-text-xs);
  }

  .footer-step {
    display: flex;
    align-items: center;
    gap: 6px;
    color: hsl(var(--muted-foreground));
    font-family: var(--ak-font-sans);
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: hsl(var(--muted));
    color: hsl(var(--foreground));
    font-size: 10px;
    font-weight: 600;
  }

  .footer-arrow {
    color: hsl(var(--ak-neutral-400));
    font-size: 11px;
  }

  .footer-step.blocked {
    color: hsl(var(--destructive-muted));
    font-weight: 500;
  }

  .footer-step.blocked :global(svg) {
    color: hsl(var(--destructive));
  }

  @media (max-width: 980px) {
    .inner {
      grid-template-columns: 1fr;
      gap: var(--ak-space-10);
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: var(--ak-space-12) var(--ak-space-4) var(--ak-space-10);
    }
    h1 { font-size: var(--ak-text-3xl); }
    .lead { font-size: var(--ak-text-base); }
    .ctas .btn { flex: 1 1 100%; }
    .install { max-width: none; }
    .showcase-header { padding: var(--ak-space-2) var(--ak-space-3); }
    .showcase-footer {
      flex-wrap: wrap;
      gap: var(--ak-space-2);
      padding: var(--ak-space-2) var(--ak-space-3);
    }
    .footer-arrow { display: none; }
  }
</style>
