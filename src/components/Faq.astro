---
import Icon from './Icon.astro';

const faqs = [
  {
    q: 'How does it keep AI agents from misusing tools?',
    a: 'Every MCP tool sits in one of three tiers: public, scoped to an OAuth 2.1 token, or human-approved with a passkey. Approval covers a hash of the exact arguments, so a changed value fails the call. Third-party credentials stay in a server-side vault.',
  },
  {
    q: 'Should I use this or Keycloak, Ory or Zitadel?',
    a: 'Use Authkestra when you are building in Rust and want auth in-process with no sidecar. Use a standalone IdP if you need an admin console, SAML, or workforce SSO. You can connect the two over OIDC.',
  },
  {
    q: 'How does stateless OAuth work without a session database?',
    a: 'OAuth state and PKCE verifiers live in an AES-256-GCM encrypted cookie. On callback the engine decrypts it in memory, so you can scale out without Redis or SQL for sessions.',
  },
  {
    q: 'Does it work with my framework and database?',
    a: 'Yes. The core has no framework dependency. There are Axum and Actix-web adapters, and stores for memory, Redis, PostgreSQL, MySQL and SQLite. You can implement the store traits for anything else.',
  },
];
---
<section id="faq" class="faq" aria-labelledby="faq-heading">
  <div class="inner">
    <div class="faq-layout">
      <div class="header">
        <h2 id="faq-heading">Frequently Asked Questions</h2>
        <p class="lead">Short answers. The docs have the rest.</p>
        <div class="faq-links">
          <a href="https://docs.authkestra.com" target="_blank" rel="noopener noreferrer">
            <span>Documentation</span>
          </a>
          <a href="https://github.com/Authkestra/authkestra/blob/main/SECURITY.md" target="_blank" rel="noopener noreferrer">
            <span>Security policy</span>
          </a>
          <a href="https://play.authkestra.com" target="_blank" rel="noopener noreferrer">
            <span>Playground</span>
          </a>
        </div>
      </div>

      <div class="faq-list">
        {faqs.map((item, idx) => (
          <details class="faq-item" open={idx === 0}>
            <summary class="faq-summary">
              <h3>{item.q}</h3>
              <div class="chevron-wrap">
                <Icon name="chevron-down" size={18} class="chevron" aria-hidden="true" />
              </div>
            </summary>
            <div class="faq-answer">
              <p>{item.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .faq {
    max-width: var(--ak-layout-max);
    margin: 0 auto;
    padding: var(--ak-space-24) var(--ak-space-6);
  }

  .inner {
    position: relative;
  }

  .faq-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.4fr) minmax(0, 0.6fr);
    gap: var(--ak-space-12);
    align-items: start;
  }

  .header {
    position: sticky;
    top: 6rem;
  }


  h2 {
    font-size: var(--ak-text-3xl);
    letter-spacing: var(--ak-tracking-tight);
    color: hsl(var(--foreground));
  }

  .lead {
    margin-top: var(--ak-space-4);
    font-size: var(--ak-text-lg);
    line-height: var(--ak-leading-relaxed);
    color: hsl(var(--ak-neutral-300));
  }

  .faq-links {
    margin-top: var(--ak-space-6);
    display: flex;
    flex-direction: column;
    gap: var(--ak-space-3);
    padding-top: var(--ak-space-6);
    border-top: 1px solid hsl(var(--border));
  }

  .faq-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--ak-space-2);
    font-size: var(--ak-text-sm);
    font-weight: 500;
    color: hsl(var(--primary-accent));
    text-decoration: none;
  }

  .faq-links a:hover {
    text-decoration: underline;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--ak-space-4);
  }

  .faq-item {
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color var(--ak-duration-fast) var(--ak-ease-out);
  }

  .faq-item:hover {
    border-color: hsl(var(--input));
  }

  .faq-item[open] {
    border-color: hsl(var(--input));
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ak-space-4);
    padding: var(--ak-space-5) var(--ak-space-6);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-summary h3 {
    font-size: var(--ak-text-base);
    font-weight: 600;
    color: hsl(var(--foreground));
    margin: 0;
    line-height: var(--ak-leading-snug);
  }

  .chevron-wrap {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--ak-radius-sm);
    background: hsl(var(--ak-neutral-800));
    color: hsl(var(--ak-neutral-300));
    transition: transform var(--ak-duration-fast) var(--ak-ease-out), color var(--ak-duration-fast) var(--ak-ease-out);
  }

  .faq-summary:hover .chevron-wrap {
    color: hsl(var(--primary-accent));
  }

  .faq-item[open] .chevron-wrap {
    transform: rotate(180deg);
    color: hsl(var(--primary-accent));
  }

  .faq-answer {
    padding: 0 var(--ak-space-6) var(--ak-space-6);
  }

  .faq-answer p {
    font-size: var(--ak-text-sm);
    line-height: var(--ak-leading-relaxed);
    color: hsl(var(--ak-neutral-300));
    margin: 0;
  }

  @media (max-width: 960px) {
    .faq-layout {
      grid-template-columns: 1fr;
      gap: var(--ak-space-8);
    }
    .header {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .faq {
      padding: var(--ak-space-16) var(--ak-space-4);
    }
    .faq-summary {
      padding: var(--ak-space-4);
    }
    .faq-answer {
      padding: 0 var(--ak-space-4) var(--ak-space-4);
    }
  }
</style>
