---
import Icon from './Icon.astro';
import { highlightRust } from '../lib/rust-highlight';

const stages = [
  { id: 'agent-call', label: 'AI Agent Call', sub: 'MCP JSON-RPC', icon: 'bot', cx: 110 },
  { id: 'policy-jcs', label: 'Policy & JCS Binding', sub: 'RFC 8785 SHA-256', icon: 'shield-check', cx: 330 },
  { id: 'passkey-pulse', label: 'Passkey Biometric Pulse', sub: 'WebAuthn Step-Up', icon: 'fingerprint', cx: 550 },
  { id: 'vault-token', label: 'Scoped Vault Token', sub: 'Zero-Trust Proof', icon: 'lock', cx: 770 },
];

const snippets: Record<string, string> = {
  'agent-call': `// 1. Intercept MCP JSON-RPC "tools/call"
let tool_call = McpToolCall::parse(&request)?;
let caller = CallerIdentity::from_mcp_session(&session)?;

// Validate schema and extract caller tool intent
let (tool_name, arguments) = tool_call.into_parts();`,

  'policy-jcs': `// 2. Canonicalize parameters & evaluate Cedar policy
let digest = authkestra_mcp::jcs_sha256(&session_id, &tool_name, &args, expires_at);
let decision = engine.evaluate_policy(
    &caller,
    "tools:call",
    &Resource::mcp_tool(&tool_name, &digest),
)?;
assert!(decision.is_permitted());`,

  'passkey-pulse': `// 3. Cryptographic HITL passkey step-up challenge
let challenge = reproof_client
    .create_challenge(&caller, &digest, Duration::from_secs(300))?;

// User authenticates with physical FIDO2 biometric pulse
let approval = reproof_client
    .verify_passkey_assertion(&challenge, &assertion)
    .await?;`,

  'vault-token': `// 4. Scoped execution proof & zero-trust token vault
let proof = tool_vault.dispense_scoped_token(
    &approval,
    &["tools:execute:transfer"],
    Duration::from_secs(60),
)?;
let execution = tool_handler.execute(&args, &proof).await?;`,
};

const highlighted = Object.fromEntries(
  Object.entries(snippets).map(([id, code]) => [id, highlightRust(code)]),
);
---
<section id="flow" class="flow" aria-labelledby="flow-heading">
  <div class="copy">
    <h2 id="flow-heading">Cryptographic AI Agent &amp; MCP Tool Execution Flow</h2>
    <p>
      Watch an autonomous AI agent attempt a high-stakes MCP tool invocation. Authkestra intercepts
      the JSON-RPC call, locks parameters with RFC 8785 JCS SHA-256 digests, mandates a human
      passkey biometric step-up, and dispenses a zero-trust, short-lived scoped vault token.
    </p>
  </div>

  <div class="stage">
    <div class="visual">
      <svg
        class="diagram run"
        viewBox="0 0 880 300"
        role="img"
        aria-hidden="true"
        data-active-stage="agent-call"
      >
        <!-- Static background guide rails -->
        <g class="rails">
          <path class="rail rail-base" d="M110,140 L770,140" />
          <path class="rail" d="M110,140 L330,140" pathLength="1" />
          <path class="rail" d="M330,140 L550,140" pathLength="1" />
          <path class="rail" d="M550,140 L770,140" pathLength="1" />
        </g>

        <!-- Animated signal pulses -->
        <g class="pulses">
          <path class="pulse p-seg-1" d="M110,140 L330,140" pathLength="1" />
          <path class="pulse p-seg-2" d="M330,140 L550,140" pathLength="1" />
          <path class="pulse p-seg-3" d="M550,140 L770,140" pathLength="1" />
        </g>

        <!-- Dynamic traveling particles -->
        <g class="particles" aria-hidden="true">
          <circle class="flow-particle part-1" r="4" cy="140" />
          <circle class="flow-particle part-2" r="4" cy="140" />
          <circle class="flow-particle part-3" r="4" cy="140" />
        </g>

        <!-- Pipeline Nodes -->
        {stages.map((s, idx) => (
          <g class="stage-node" data-stage={s.id} transform={`translate(${s.cx}, 140)`}>
            <!-- Aura glow / Biometric wave rings -->
            <circle r="44" class="node-aura" />
            {s.id === 'passkey-pulse' && (
              <>
                <circle r="36" class="biometric-pulse wave-1" />
                <circle r="48" class="biometric-pulse wave-2" />
              </>
            )}

            <!-- Step pill badge -->
            <g transform="translate(0, -56)">
              <rect x="-26" y="-10" width="52" height="18" rx="9" class="step-pill" />
              <text x="0" y="3" class="step-text" text-anchor="middle">STEP {idx + 1}</text>
            </g>

            <!-- Node central chip -->
            <circle r="28" class="node-chip" />
            <g transform="translate(-11, -11)" class="node-glyph">
              <Icon name={s.icon} size={22} />
            </g>

            <!-- Labels -->
            <text x="0" y="48" class="node-label" text-anchor="middle">{s.label}</text>
            <text x="0" y="64" class="node-sub" text-anchor="middle">{s.sub}</text>
          </g>
        ))}
      </svg>

      <ul class="legend">
        {stages.map((s) => (
          <li data-stage={s.id} role="button" tabindex="0">
            <Icon name={s.icon} size={16} aria-hidden="true" />
            <span>{s.label}</span>
          </li>
        ))}
      </ul>
      <p class="pipeline">AI Agent / MCP Tool Call → Policy &amp; JCS SHA-256 Binding → Human Passkey Biometric Pulse → Scoped Execution Proof &amp; Zero-Trust Vault Token</p>
    </div>

    <div class="code-panel">
      <div class="code-chrome" aria-hidden="true">
        <span class="win red"></span>
        <span class="win yellow"></span>
        <span class="win green"></span>
        <span class="code-title">mcp_execution_ceremony.rs</span>
      </div>
      <div class="code-stack">
        {stages.map((s, idx) => (
          <pre
            class:list={['code', { off: idx !== 0 }]}
            data-snippet={s.id}
            aria-hidden={idx !== 0 ? 'true' : undefined}
          ><code>{highlighted[s.id].map((line) => (
            <span class="code-line" set:html={line || '&nbsp;'} />
          ))}</code></pre>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const svg = document.querySelector<SVGSVGElement>('#flow .diagram');
  const snippetEls = document.querySelectorAll<HTMLElement>('#flow .code[data-snippet]');
  const legendItems = document.querySelectorAll<HTMLElement>('#flow .legend li');
  const stageNodes = document.querySelectorAll<SVGGElement>('#flow .stage-node');

  if (svg) {
    const stages = ['agent-call', 'policy-jcs', 'passkey-pulse', 'vault-token'];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;

    const setActive = (stageId: string) => {
      svg.setAttribute('data-active-stage', stageId);
      snippetEls.forEach((el) => {
        const off = el.dataset.snippet !== stageId;
        el.classList.toggle('off', off);
        if (off) el.setAttribute('aria-hidden', 'true');
        else el.removeAttribute('aria-hidden');
      });
      legendItems.forEach((l) => l.classList.toggle('active', l.dataset.stage === stageId));
      stageNodes.forEach((node) => node.classList.toggle('active', node.dataset.stage === stageId));
    };

    const cycle = () => {
      setActive(stages[i]);
      i = (i + 1) % stages.length;
    };

    legendItems.forEach((item) => {
      item.addEventListener('click', () => {
        const stage = item.dataset.stage;
        if (stage) {
          const idx = stages.indexOf(stage);
          if (idx !== -1) {
            i = idx;
            setActive(stage);
          }
        }
      });
    });

    if (reduced) {
      setActive('policy-jcs');
    } else {
      cycle();
      setInterval(cycle, 4000);
    }
  }
</script>

<style>
  .flow {
    max-width: var(--ak-layout-max);
    margin: 0 auto;
    padding: 0 var(--ak-space-6) var(--ak-space-24);
  }

  .copy {
    max-width: 68ch;
    margin-bottom: var(--ak-space-10);
  }

  .copy h2 {
    font-size: var(--ak-text-3xl);
    letter-spacing: var(--ak-tracking-tight);
    color: hsl(var(--foreground));
  }

  .copy p {
    margin-top: var(--ak-space-4);
    color: hsl(var(--muted-foreground));
    font-size: var(--ak-text-base);
    line-height: var(--ak-leading-relaxed);
  }

  .stage {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--ak-space-8);
    align-items: start;
  }

  .visual,
  .code-panel {
    min-width: 0;
  }

  .visual {
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--ak-radius-xl);
    padding: var(--ak-space-6);
  }

  .diagram {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Rails */
  .rail {
    fill: none;
    stroke: hsl(var(--border));
    stroke-width: 2;
  }

  .rail-base {
    stroke: hsl(var(--border) / 0.5);
    stroke-dasharray: 4 4;
  }

  /* Pulses */
  .pulse {
    fill: none;
    stroke: hsl(var(--primary-accent));
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 60 160;
    animation: dashLoop 2.4s linear infinite;
  }

  .p-seg-1 { animation-delay: 0s; }
  .p-seg-2 { animation-delay: 0.8s; }
  .p-seg-3 { animation-delay: 1.6s; }

  @keyframes dashLoop {
    0% {
      stroke-dashoffset: 220;
      opacity: 0.2;
    }
    30% {
      opacity: 1;
    }
    70% {
      opacity: 1;
    }
    100% {
      stroke-dashoffset: -220;
      opacity: 0.2;
    }
  }

  /* Traveling Particles */
  .flow-particle {
    fill: hsl(var(--primary-accent));
    filter: drop-shadow(0 0 6px hsl(var(--primary-accent) / 0.8));
    animation: travelParticle 4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .part-1 { animation-delay: 0s; }
  .part-2 { animation-delay: 1.33s; }
  .part-3 { animation-delay: 2.66s; }

  @keyframes travelParticle {
    0% {
      cx: 110px;
      opacity: 0;
      r: 3px;
    }
    10% {
      opacity: 1;
      r: 5px;
    }
    90% {
      opacity: 1;
      r: 5px;
    }
    100% {
      cx: 770px;
      opacity: 0;
      r: 3px;
    }
  }

  /* Stage Nodes */
  .stage-node {
    transition: transform var(--ak-duration-fast) var(--ak-ease-out);
    cursor: pointer;
  }

  .node-aura {
    fill: hsl(var(--primary) / 0.08);
    stroke: hsl(var(--primary-accent) / 0.2);
    stroke-width: 1.5;
    transition: all var(--ak-duration-fast) var(--ak-ease-out);
  }

  .stage-node.active .node-aura {
    fill: hsl(var(--primary-subtle) / 0.4);
    stroke: hsl(var(--primary-accent) / 0.6);
    filter: drop-shadow(0 0 12px hsl(var(--primary-accent) / 0.35));
    animation: auraPulse 2s ease-in-out infinite;
  }

  @keyframes auraPulse {
    0%, 100% { r: 44px; opacity: 0.6; }
    50% { r: 48px; opacity: 1; }
  }

  /* Biometric wave */
  .biometric-pulse {
    fill: none;
    stroke: hsl(var(--primary-accent));
    stroke-width: 1.5;
    opacity: 0;
    animation: bioRadar 2.4s cubic-bezier(0.1, 0.7, 0.3, 1) infinite;
  }

  .wave-2 { animation-delay: 1.2s; }

  @keyframes bioRadar {
    0% {
      r: 28px;
      opacity: 0.8;
      stroke-width: 2px;
    }
    100% {
      r: 56px;
      opacity: 0;
      stroke-width: 0.5px;
    }
  }

  .step-pill {
    fill: hsl(var(--ak-neutral-800));
    stroke: hsl(var(--border));
    stroke-width: 1;
  }

  .step-text {
    font-size: 8px;
    font-family: var(--ak-font-mono);
    font-weight: 700;
    fill: hsl(var(--muted-foreground));
    letter-spacing: 0.05em;
  }

  .stage-node.active .step-pill {
    fill: hsl(var(--primary-subtle));
    stroke: hsl(var(--primary-accent));
  }

  .stage-node.active .step-text {
    fill: hsl(var(--primary-accent));
  }

  .node-chip {
    fill: hsl(var(--card));
    stroke: hsl(var(--border));
    stroke-width: 2;
    transition: all var(--ak-duration-fast) var(--ak-ease-out);
  }

  .stage-node.active .node-chip {
    fill: hsl(var(--primary-subtle));
    stroke: hsl(var(--primary-accent));
    stroke-width: 2.5;
  }

  .node-glyph {
    color: hsl(var(--muted-foreground));
    transition: color var(--ak-duration-fast) var(--ak-ease-out);
  }

  .stage-node.active .node-glyph {
    color: hsl(var(--primary-accent));
  }

  .node-label {
    font-size: 11px;
    font-family: var(--ak-font-sans);
    font-weight: 600;
    fill: hsl(var(--foreground));
  }

  .node-sub {
    font-size: 9px;
    font-family: var(--ak-font-mono);
    fill: hsl(var(--muted-foreground));
  }

  .stage-node.active .node-sub {
    fill: hsl(var(--primary-accent));
  }

  /* Legend */
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ak-space-2) var(--ak-space-4);
    margin-top: var(--ak-space-6);
    padding-top: var(--ak-space-5);
    border-top: 1px solid hsl(var(--border));
    list-style: none;
    padding-left: 0;
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: var(--ak-space-2);
    font-size: var(--ak-text-xs);
    color: hsl(var(--muted-foreground));
    padding: var(--ak-space-1) var(--ak-space-3);
    border-radius: var(--ak-radius-sm);
    cursor: pointer;
    transition: all var(--ak-duration-fast) var(--ak-ease-out);
  }

  .legend li:hover {
    color: hsl(var(--foreground));
    background: hsl(var(--accent));
  }

  .legend li.active {
    color: hsl(var(--primary-accent));
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    font-weight: 600;
  }

  .pipeline {
    margin-top: var(--ak-space-4);
    font-size: var(--ak-text-2xs);
    color: hsl(var(--muted-foreground));
    font-family: var(--ak-font-mono);
    line-height: var(--ak-leading-normal);
  }

  /* Code Panel */
  .code-panel {
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--ak-radius-xl);
    overflow: hidden;
    align-self: stretch;
  }

  .code-chrome {
    display: flex;
    align-items: center;
    gap: var(--ak-space-2);
    padding: var(--ak-space-3) var(--ak-space-4);
    border-bottom: 1px solid hsl(var(--border));
    background: hsl(var(--ak-neutral-900));
  }

  .win {
    width: 9px;
    height: 9px;
    border-radius: var(--ak-radius-full);
  }

  .win.red { background: hsl(var(--destructive)); }
  .win.yellow { background: hsl(var(--warning)); }
  .win.green { background: hsl(var(--success)); }

  .code-title {
    margin-left: var(--ak-space-2);
    font-size: var(--ak-text-2xs);
    font-family: var(--ak-font-mono);
    color: hsl(var(--muted-foreground));
  }

  .code-stack {
    display: grid;
  }

  .code-stack > .code {
    grid-area: 1 / 1;
  }

  .code {
    margin: 0;
    padding: var(--ak-space-5);
    font-family: var(--ak-font-mono);
    font-size: var(--ak-text-xs);
    line-height: var(--ak-leading-relaxed);
    overflow-x: auto;
  }

  .code.off {
    visibility: hidden;
  }

  .code-line {
    display: block;
    color: hsl(var(--code-plain));
    white-space: pre;
  }

  .code-line :global(.t-keyword) { color: hsl(var(--code-keyword)); }
  .code-line :global(.t-type) { color: hsl(var(--code-type)); }
  .code-line :global(.t-literal) { color: hsl(var(--code-literal)); }
  .code-line :global(.t-macro) { color: hsl(var(--code-keyword)); }
  .code-line :global(.t-comment) { color: hsl(var(--code-comment)); font-style: italic; }
  .code-line :global(.t-fn) { color: hsl(var(--code-fn)); }

  @media (prefers-reduced-motion: reduce) {
    .pulse {
      stroke-dashoffset: 0 !important;
      opacity: 0.8 !important;
      animation: none !important;
    }
    .flow-particle {
      display: none !important;
    }
    .node-aura,
    .biometric-pulse {
      animation: none !important;
    }
    .stage-node.active .node-aura {
      opacity: 0.8 !important;
    }
  }

  @media (max-width: 900px) {
    .stage {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .flow {
      padding: 0 var(--ak-space-4) var(--ak-space-16);
    }
    .visual { padding: var(--ak-space-4); }
  }
</style>
