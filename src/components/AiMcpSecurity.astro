---
import Icon from './Icon.astro';

const tiers = [
  {
    tier: 'Tier 1',
    name: 'Public',
    badge: 'Open / Context-Aware',
    icon: 'circle-check',
    diagram: 'tier1',
    desc: 'Callable without authentication or with optional caller identity context. Ideal for read-only queries, system capabilities, and public documentation searches.',
    features: [
      'Zero credential overhead for safe tools',
      'Optional caller identity injection',
      'Rate-limiting and telemetry ready',
    ],
  },
  {
    tier: 'Tier 2',
    name: 'Scoped Resource Guard',
    badge: 'OAuth 2.1 & RFC 9728',
    icon: 'shield-check',
    diagram: 'tier2',
    desc: 'Requires a valid bearer or RFC 9449 DPoP token verified via authkestra-resource. Missing or insufficient scopes trigger RFC 9728 resource metadata elicitation.',
    features: [
      'RFC 9728 /.well-known/oauth-protected-resource',
      'DPoP (RFC 9449) & mTLS (RFC 8705) sender binding',
      'Automatic 401 WWW-Authenticate challenge elicitation',
    ],
  },
  {
    tier: 'Tier 3',
    name: 'HumanApproved (HITL Step-Up)',
    badge: 'RFC 8785 JCS & Biometrics',
    icon: 'key',
    diagram: 'tier3',
    desc: 'Mandates cryptographic human approval bound to canonicalized tool parameters. Prevents unauthorized financial transfers, deletions, or external API execution.',
    features: [
      'RFC 8785 JSON Canonicalization Scheme (JCS)',
      'Deterministic SHA-256 challenge digest binding',
      'Physical WebAuthn Passkey / TOTP re-proof',
      'Atomic single-use token consumption (AtomicConsume)',
      'Deterministic parameter tampering rejection',
    ],
  },
];
---
<section id="ai-mcp-security" class="ai-mcp" aria-labelledby="ai-mcp-heading">
  <span id="ai-agents-mcp" class="anchor-alias" aria-hidden="true"></span>
  <div class="inner">
    <div class="header">
      <div class="pill">
        <Icon name="bot" size={16} class="pill-icon" aria-hidden="true" />
        <span>authkestra-mcp</span>
      </div>
      <h2 id="ai-mcp-heading">AI Agent &amp; Model Context Protocol (MCP) Security</h2>
      <p class="lead">
        Autonomous AI agents need access to tools, but giving LLMs unrestricted execution rights
        or raw API keys is an existential security risk. <code>authkestra-mcp</code> intercepts MCP
        JSON-RPC requests with three composable security tiers, cryptographic parameter binding,
        and zero-trust credential isolation.
      </p>
    </div>

    <!-- 3-Tier Grid with 2D Animated SVGs -->
    <div class="tiers-grid">
      {tiers.map((t) => (
        <div class="tier-card">
          <div class="tier-header">
            <span class="tier-num">{t.tier}</span>
            <span class="tier-badge">{t.badge}</span>
          </div>

          <div class="tier-title-row">
            <div class="tier-icon-wrap">
              <Icon name={t.icon} size={20} class="tier-icon" aria-hidden="true" />
            </div>
            <h3>{t.name}</h3>
          </div>

          <!-- 2D Animated SVG Diagram for Tier -->
          <div class="tier-diagram-wrap">
            {t.diagram === 'tier1' && (
              <svg class="tier-diagram svg-tier-1" viewBox="0 0 320 110" role="img" aria-label="Tier 1 Public Open Conduit">
                <path class="t-rail" d="M36,55 L284,55" />
                <path class="t-stream stream-tier-1" d="M36,55 L284,55" />
                <path class="t-tap" d="M160,20 L160,55" />
                <circle cx="160" cy="20" r="5" class="t-tap-dot" />
                <text x="160" y="12" class="t-diagram-caption" text-anchor="middle">Context Tap</text>

                <circle class="t-particle t-p1" r="3.5" cy="55" />
                <circle class="t-particle t-p2" r="3.5" cy="55" />

                <g transform="translate(36, 55)">
                  <circle r="16" class="t-node-chip" />
                  <text x="0" y="3" class="t-node-glyph" text-anchor="middle">LLM</text>
                  <text x="0" y="26" class="t-diagram-sub" text-anchor="middle">Caller</text>
                </g>
                <g transform="translate(284, 55)">
                  <circle r="16" class="t-node-chip t-node-success" />
                  <text x="0" y="3" class="t-node-glyph t-glyph-success" text-anchor="middle">Tool</text>
                  <text x="0" y="26" class="t-diagram-sub" text-anchor="middle">Public</text>
                </g>
              </svg>
            )}

            {t.diagram === 'tier2' && (
              <svg class="tier-diagram svg-tier-2" viewBox="0 0 320 110" role="img" aria-label="Tier 2 Scoped Resource Guard">
                <path class="t-rail" d="M36,55 L140,55" />
                <path class="t-rail" d="M180,55 L284,55" />
                <path class="t-stream stream-tier-2" d="M180,55 L284,55" />

                <g class="t-gate" transform="translate(160, 55)">
                  <circle r="22" class="t-gate-aura" />
                  <path class="t-shield" d="M-12,-13 L12,-13 L12,2 C12,11 0,16 0,16 C0,16 -12,11 -12,2 Z" />
                  <text x="0" y="3" class="t-gate-text" text-anchor="middle">DPoP</text>
                  <path class="t-challenge-loop" d="M-8,-16 C-8,-30 8,-30 8,-16" />
                </g>

                <circle class="t-particle t-p-scoped-in" r="3.5" cy="55" />
                <circle class="t-particle t-p-scoped-out" r="3.5" cy="55" />

                <g transform="translate(36, 55)">
                  <circle r="16" class="t-node-chip" />
                  <text x="0" y="3" class="t-node-glyph" text-anchor="middle">OAuth</text>
                  <text x="0" y="26" class="t-diagram-sub" text-anchor="middle">Bearer</text>
                </g>
                <g transform="translate(284, 55)">
                  <circle r="16" class="t-node-chip t-node-success" />
                  <text x="0" y="3" class="t-node-glyph t-glyph-success" text-anchor="middle">Tool</text>
                  <text x="0" y="26" class="t-diagram-sub" text-anchor="middle">Scoped</text>
                </g>
              </svg>
            )}

            {t.diagram === 'tier3' && (
              <svg class="tier-diagram svg-tier-3" viewBox="0 0 320 110" role="img" aria-label="Tier 3 HumanApproved HITL Step-Up">
                <path class="t-rail" d="M36,55 L90,55" />
                <path class="t-rail t-rail-bridge" d="M130,55 L190,55" />
                <path class="t-stream stream-tier-3" d="M230,55 L284,55" />

                <g class="t-lock-node" transform="translate(110, 55)">
                  <rect x="-14" y="-11" width="28" height="22" rx="4" class="t-lock-body" />
                  <path class="t-lock-shackle" d="M-7,-11 C-7,-20 7,-20 7,-11" />
                  <text x="0" y="3" class="t-lock-label" text-anchor="middle">JCS</text>
                  <text x="0" y="24" class="t-diagram-sub" text-anchor="middle">SHA-256</text>
                </g>

                <g class="t-bio-node" transform="translate(210, 55)">
                  <circle r="22" class="t-bio-wave wave-a" />
                  <circle r="32" class="t-bio-wave wave-b" />
                  <circle r="16" class="t-bio-chip" />
                  <text x="0" y="3" class="t-bio-glyph" text-anchor="middle">FIDO2</text>
                  <text x="0" y="24" class="t-diagram-sub" text-anchor="middle">Passkey</text>
                </g>

                <g transform="translate(36, 55)">
                  <circle r="16" class="t-node-chip" />
                  <text x="0" y="3" class="t-node-glyph" text-anchor="middle">Agent</text>
                  <text x="0" y="26" class="t-diagram-sub" text-anchor="middle">Call</text>
                </g>
                <g transform="translate(284, 55)">
                  <circle r="16" class="t-node-chip t-node-success" />
                  <text x="0" y="3" class="t-node-glyph t-glyph-success" text-anchor="middle">Exec</text>
                  <text x="0" y="26" class="t-diagram-sub" text-anchor="middle">Proof</text>
                </g>
              </svg>
            )}
          </div>

          <p class="tier-desc">{t.desc}</p>
          <ul class="tier-features">
            {t.features.map((f) => (
              <li>
                <Icon name="check" size={14} class="feature-check" aria-hidden="true" />
                <span>{f}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Deep Dive Architecture: JCS Parameter Tamper, Token Vault, & Typestate Guardrail -->
    <div class="architecture-grid">
      <div class="arch-card">
        <div class="arch-icon-wrap">
          <Icon name="shield-alert" size={24} class="arch-icon" aria-hidden="true" />
        </div>
        <h3>Cryptographic JCS Parameter Tampering Defense</h3>
        <p>
          Prompt injections and model hallucinations can cause agents to alter critical arguments
          after receiving user approval. Authkestra solves this with strict <strong>RFC 8785 JSON
          Canonicalization Scheme (JCS)</strong>:
        </p>
        <div class="formula-box">
          <code>SHA-256(session_id ‖ tool_name ‖ JCS(args) ‖ expires_at)</code>
        </div>
        <p>
          If an adversary or model mutates even a single character, key ordering, or numeric value
          (e.g., <code>amount: 50</code> to <code>amount: 5000</code>) between approval and invocation,
          the challenge digest check fails instantly, aborting execution.
        </p>
      </div>

      <div class="arch-card">
        <div class="arch-icon-wrap">
          <Icon name="lock" size={24} class="arch-icon" aria-hidden="true" />
        </div>
        <h3>Zero-Trust Downstream Token Vault</h3>
        <p>
          Never expose raw OAuth2 refresh tokens, client secrets, or API keys inside the LLM prompt
          context. With <code>DownstreamTokenBroker</code> and <code>EncryptedKvTokenVault</code>:
        </p>
        <ul class="arch-list">
          <li>Tokens are encrypted at rest with AES-256-GCM via <code>authkestra-crypto-util</code>.</li>
          <li>Tool handlers receive an isolated <code>ToolContext</code> scoped to the verified caller.</li>
          <li>Downstream API requests resolve short-lived bearer tokens just-in-time on the server.</li>
        </ul>
      </div>

      <div class="arch-card">
        <div class="arch-icon-wrap">
          <Icon name="square-function" size={24} class="arch-icon" aria-hidden="true" />
        </div>
        <h3>AI-Proof Typestate Compiler Guardrail</h3>
        <p>
          When AI coding assistants generate authentication code, they frequently omit session
          stores, skip token validation, or forget CSRF middleware. Authkestra's Rust typestate
          pattern <code>Engine&lt;S, T&gt;</code> encodes security prerequisites into the compiler:
        </p>

        <!-- 2D Animated Typestate Guardrail SVG -->
        <div class="typestate-diagram-wrap">
          <svg class="typestate-diagram" viewBox="0 0 340 136" role="img" aria-label="Typestate Compiler Guardrail Diagram">
            <!-- Top Lane: Incomplete Config Halted at Compile-Time -->
            <g class="lane lane-halted" transform="translate(0, 36)">
              <path class="lane-rail" d="M30,0 L150,0" />
              <circle class="lane-particle particle-halt" r="3.5" cy="0" />
              <g transform="translate(30, 0)">
                <circle r="12" class="lane-node node-halt" />
                <text x="0" y="3" class="lane-node-text" text-anchor="middle">S1</text>
              </g>
              <g class="barrier" transform="translate(150, 0)">
                <rect x="-4" y="-16" width="8" height="32" rx="2" class="barrier-wall" />
                <text x="12" y="-4" class="barrier-title">error[E0277]</text>
                <text x="12" y="8" class="barrier-sub">MissingStore unsatisfied</text>
              </g>
              <text x="30" y="-16" class="lane-title">Incomplete Builder</text>
            </g>

            <!-- Bottom Lane: Complete Typestate Verified by rustc -->
            <g class="lane lane-verified" transform="translate(0, 98)">
              <path class="lane-rail" d="M30,0 L290,0" />
              <path class="lane-stream" d="M30,0 L290,0" />
              <circle class="lane-particle particle-pass" r="3.5" cy="0" />
              <g transform="translate(30, 0)">
                <circle r="12" class="lane-node node-ok" />
                <text x="0" y="3" class="lane-node-text" text-anchor="middle">S2</text>
              </g>
              <g class="gateway" transform="translate(150, 0)">
                <rect x="-4" y="-16" width="8" height="32" rx="2" class="gateway-post" />
                <text x="0" y="-20" class="gateway-tag" text-anchor="middle">rustc verified</text>
              </g>
              <g transform="translate(290, 0)">
                <circle r="13" class="lane-node node-prod" />
                <text x="0" y="3" class="lane-node-text text-success" text-anchor="middle">✓</text>
                <text x="0" y="20" class="barrier-sub" text-anchor="middle">0 Panics</text>
              </g>
              <text x="30" y="-16" class="lane-title ok">Engine&lt;Ready, Verified&gt;</text>
            </g>
          </svg>
        </div>

        <p class="typestate-foot">
          Any incomplete configuration causes an instant compiler error, preventing LLM hallucinations
          from reaching production.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .ai-mcp {
    max-width: var(--ak-layout-max);
    margin: 0 auto;
    padding: var(--ak-space-24) var(--ak-space-6);
    position: relative;
  }

  .anchor-alias {
    position: absolute;
    top: 0;
    left: 0;
    visibility: hidden;
  }

  .inner {
    position: relative;
  }

  .header {
    max-width: 72ch;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--ak-space-2);
    padding: var(--ak-space-1) var(--ak-space-3);
    border-radius: var(--ak-radius-full);
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    font-size: var(--ak-text-xs);
    font-family: var(--ak-font-mono);
    color: hsl(var(--primary-accent));
    margin-bottom: var(--ak-space-4);
  }

  .pill-icon {
    color: hsl(var(--primary-accent));
  }

  h2 {
    font-size: var(--ak-text-3xl);
    letter-spacing: var(--ak-tracking-tight);
    color: hsl(var(--foreground));
  }

  .lead {
    margin-top: var(--ak-space-4);
    font-size: var(--ak-text-lg);
    line-height: var(--ak-leading-relaxed);
    color: hsl(var(--muted-foreground));
  }

  /* Tiers Grid */
  .tiers-grid {
    margin-top: var(--ak-space-12);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--ak-space-6);
  }

  .tier-card {
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    padding: var(--ak-space-6);
    display: flex;
    flex-direction: column;
    transition: border-color var(--ak-duration-fast) var(--ak-ease-out);
  }

  .tier-card:hover {
    border-color: hsl(var(--input));
  }

  .tier-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--ak-space-4);
  }

  .tier-num {
    font-size: var(--ak-text-xs);
    font-family: var(--ak-font-mono);
    font-weight: 600;
    color: hsl(var(--primary-accent));
    text-transform: uppercase;
    letter-spacing: var(--ak-tracking-wide);
  }

  .tier-badge {
    font-size: var(--ak-text-2xs);
    background: hsl(var(--ak-neutral-800));
    color: hsl(var(--ak-neutral-300));
    padding: 2px 8px;
    border-radius: var(--ak-radius-sm);
    font-family: var(--ak-font-mono);
  }

  .tier-title-row {
    display: flex;
    align-items: center;
    gap: var(--ak-space-3);
    margin-bottom: var(--ak-space-4);
  }

  .tier-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--ak-radius-sm);
    background: hsl(var(--ak-neutral-800));
    color: hsl(var(--primary-accent));
    flex-shrink: 0;
  }

  .tier-card h3 {
    font-size: var(--ak-text-base);
    font-weight: 600;
    color: hsl(var(--foreground));
  }

  /* 2D Animated Diagram Wrappers */
  .tier-diagram-wrap {
    margin-bottom: var(--ak-space-5);
    background: hsl(var(--ak-neutral-900));
    border: 1px solid hsl(var(--border));
    border-radius: var(--ak-radius-md);
    padding: var(--ak-space-3);
    overflow: hidden;
  }

  .tier-diagram {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Shared SVG Diagram Styles */
  .t-rail {
    fill: none;
    stroke: hsl(var(--border));
    stroke-width: 2;
  }

  .t-stream {
    fill: none;
    stroke: hsl(var(--primary-accent));
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 40 80;
    animation: tierStreamFlow 2.5s linear infinite;
  }

  @keyframes tierStreamFlow {
    0% { stroke-dashoffset: 120; opacity: 0.3; }
    50% { opacity: 1; }
    100% { stroke-dashoffset: -120; opacity: 0.3; }
  }

  .t-tap {
    stroke: hsl(var(--primary) / 0.6);
    stroke-width: 1.5;
    stroke-dasharray: 2 3;
  }

  .t-tap-dot {
    fill: hsl(var(--primary-accent));
  }

  .t-diagram-caption {
    font-size: 8px;
    font-family: var(--ak-font-mono);
    fill: hsl(var(--primary-accent));
    font-weight: 600;
  }

  .t-diagram-sub {
    font-size: 7.5px;
    font-family: var(--ak-font-mono);
    fill: hsl(var(--muted-foreground));
  }

  .t-node-chip {
    fill: hsl(var(--card));
    stroke: hsl(var(--border));
    stroke-width: 1.5;
  }

  .t-node-success {
    stroke: hsl(var(--success));
    fill: hsl(var(--primary-subtle) / 0.5);
  }

  .t-node-glyph {
    font-size: 8px;
    font-family: var(--ak-font-mono);
    font-weight: 700;
    fill: hsl(var(--foreground));
  }

  .t-glyph-success {
    fill: hsl(var(--success));
  }

  .t-particle {
    fill: hsl(var(--primary-accent));
    filter: drop-shadow(0 0 4px hsl(var(--primary-accent) / 0.8));
    animation: particleTravel 2.4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .t-p1 { animation-delay: 0s; }
  .t-p2 { animation-delay: 1.2s; }

  @keyframes particleTravel {
    0% { cx: 36px; opacity: 0; }
    15% { opacity: 1; }
    85% { opacity: 1; }
    100% { cx: 284px; opacity: 0; }
  }

  /* Tier 2 Gate Shield */
  .t-gate-aura {
    fill: hsl(var(--primary-subtle) / 0.4);
    stroke: hsl(var(--primary-accent) / 0.5);
    stroke-width: 1.5;
    animation: gatePulse 2s ease-in-out infinite;
  }

  @keyframes gatePulse {
    0%, 100% { r: 20px; opacity: 0.5; }
    50% { r: 24px; opacity: 1; }
  }

  .t-shield {
    fill: hsl(var(--card));
    stroke: hsl(var(--primary-accent));
    stroke-width: 1.5;
  }

  .t-gate-text {
    font-size: 7.5px;
    font-family: var(--ak-font-mono);
    font-weight: 700;
    fill: hsl(var(--primary-accent));
  }

  .t-challenge-loop {
    fill: none;
    stroke: hsl(var(--warning));
    stroke-width: 1.2;
    stroke-dasharray: 2 2;
    animation: loopSpin 3s linear infinite;
  }

  @keyframes loopSpin {
    0% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: 20; }
  }

  .t-p-scoped-in {
    animation: particleScopedIn 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .t-p-scoped-out {
    animation: particleScopedOut 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    animation-delay: 1s;
  }

  @keyframes particleScopedIn {
    0% { cx: 36px; opacity: 0; }
    20% { opacity: 1; }
    90% { opacity: 1; }
    100% { cx: 140px; opacity: 0; }
  }

  @keyframes particleScopedOut {
    0% { cx: 180px; opacity: 0; }
    20% { opacity: 1; }
    90% { opacity: 1; }
    100% { cx: 284px; opacity: 0; }
  }

  /* Tier 3 JCS Lock and Biometrics */
  .t-lock-body {
    fill: hsl(var(--ak-neutral-800));
    stroke: hsl(var(--primary-accent));
    stroke-width: 1.5;
  }

  .t-lock-shackle {
    fill: none;
    stroke: hsl(var(--primary-accent));
    stroke-width: 1.5;
  }

  .t-lock-label {
    font-size: 8px;
    font-family: var(--ak-font-mono);
    font-weight: 700;
    fill: hsl(var(--primary-accent));
  }

  .t-bio-chip {
    fill: hsl(var(--card));
    stroke: hsl(var(--primary-accent));
    stroke-width: 1.5;
  }

  .t-bio-glyph {
    font-size: 7px;
    font-family: var(--ak-font-mono);
    font-weight: 700;
    fill: hsl(var(--primary-accent));
  }

  .t-bio-wave {
    fill: none;
    stroke: hsl(var(--primary-accent));
    stroke-width: 1.2;
    opacity: 0;
    animation: bioPulseWave 2.4s cubic-bezier(0.1, 0.7, 0.3, 1) infinite;
  }

  .wave-b { animation-delay: 1.2s; }

  @keyframes bioPulseWave {
    0% { r: 16px; opacity: 0.9; stroke-width: 1.5px; }
    100% { r: 38px; opacity: 0; stroke-width: 0.5px; }
  }

  .t-rail-bridge {
    stroke: hsl(var(--primary-accent) / 0.5);
    stroke-dasharray: 3 3;
  }

  .tier-desc {
    font-size: var(--ak-text-sm);
    color: hsl(var(--muted-foreground));
    line-height: var(--ak-leading-normal);
    margin-bottom: var(--ak-space-5);
  }

  .tier-features {
    margin-top: auto;
    padding-top: var(--ak-space-4);
    border-top: 1px solid hsl(var(--border));
    display: flex;
    flex-direction: column;
    gap: var(--ak-space-2);
    list-style: none;
    padding-left: 0;
  }

  .tier-features li {
    display: flex;
    align-items: flex-start;
    gap: var(--ak-space-2);
    font-size: var(--ak-text-xs);
    color: hsl(var(--ak-neutral-300));
    line-height: var(--ak-leading-snug);
  }

  .feature-check {
    color: hsl(var(--success));
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Architecture Sub-Grid */
  .architecture-grid {
    margin-top: var(--ak-space-12);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--ak-space-6);
  }

  .arch-card {
    background: hsl(var(--card) / 0.6);
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
