---
import Icon from './Icon.astro';
import SpaceBanner from './SpaceBanner.astro';

const cards = [
  {
    icon: 'bot',
    title: 'AI Agent & MCP Tool Authorization',
    body: '3-tier MCP tool security with argument binding and passkey approval.',
  },
  {
    icon: 'shield',
    title: 'Typestate Compile-Time Safety',
    body: 'Missing stores become compile errors, not production panics.',
  },
  {
    icon: 'feather',
    title: 'Stateless OAuth & Zero DB Dependency',
    body: 'OAuth state lives in encrypted cookies. No session database.',
  },
  {
    icon: 'server',
    title: 'Tri-Role OAuth 2.1 Engine',
    body: 'OpenID Provider, Client, and Resource Server from one crate.',
  },
  {
    icon: 'route',
    title: 'Fine-Grained Cedar Policy & CAEP',
    body: 'Cedar policy in microseconds, with real-time session revocation.',
  },
  {
    icon: 'puzzle',
    title: 'Framework & Database Agnostic',
    body: 'Pure Rust core. Bring your own framework and database.',
  },
];
---
<section id="why" class="why" aria-labelledby="why-heading">
  <div class="inner">
    <h2 id="why-heading">Why Authkestra</h2>
    <p class="lead">
      Cryptographic rigor and compile-time guarantees, with zero sidecars.
    </p>
    <SpaceBanner src="/space/why-eclipse.webp" />

    <div class="grid">
      {cards.map((c) => (
        <div class="card">
          <div class="card-icon-wrap">
            <Icon name={c.icon} size={24} class="card-icon" aria-hidden="true" />
          </div>
          <h3>{c.title}</h3>
          <p>{c.body}</p>
        </div>
      ))}
    </div>

    <!-- Trust Signals: Security Posture & Honest Architectural Trade-offs -->
    <div id="security-posture" class="posture-grid" aria-label="Security posture and architectural fit">
      <div class="posture-card">
        <div class="posture-header">
          <span class="posture-tag">STATUS &amp; SECURITY POSTURE</span>
          <span class="posture-pill">v0.13.1 · Pre-1.0</span>
        </div>
        <h3>Maturity, Cryptographic Stack &amp; Audit Status</h3>
        <ul class="posture-list">
          <li><strong>Version:</strong> 0.13.x, MSRV 1.85. APIs may change before 1.0.</li>
          <li><strong>Primitives:</strong> ring, aws-lc-rs, webauthn-rs, cedar-policy.</li>
          <li>
            <strong>Audit:</strong> third-party audit planned before 1.0.
            <a href="https://github.com/Authkestra/authkestra/blob/main/SECURITY.md" target="_blank" rel="noopener noreferrer">Security Policy →</a>
          </li>
        </ul>
      </div>

      <div class="posture-card">
        <div class="posture-header">
          <span class="posture-tag">ARCHITECTURAL FIT</span>
          <span class="posture-pill">Embedded vs. Sidecar IdP</span>
        </div>
        <h3>When to Use (and Not Use) Authkestra</h3>
        <ul class="posture-list">
          <li><strong>Use it for:</strong> Rust APIs, web apps, and MCP servers needing in-process auth.</li>
          <li><strong>Skip it for:</strong> admin consoles, SAML federation, or polyglot workforce SSO.</li>
          <li><strong>Hybrid:</strong> keep Keycloak, Zitadel, or Ory upstream and connect via OIDC.</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .why {
    max-width: var(--ak-layout-max);
    margin: 0 auto;
    padding: var(--ak-space-24) var(--ak-space-6);
  }

  .inner {
    position: relative;
  }

  h2 {
    font-size: var(--ak-text-3xl);
    letter-spacing: var(--ak-tracking-tight);
  }

  .lead {
    margin-top: var(--ak-space-4);
    max-width: 68ch;
    font-size: var(--ak-text-lg);
    color: hsl(var(--ak-neutral-300));
    line-height: var(--ak-leading-relaxed);
  }

  .grid {
    margin-top: var(--ak-space-12);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--ak-space-6);
  }

  .card {
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    padding: var(--ak-space-6);
    transition: border-color var(--ak-duration-fast) var(--ak-ease-out);
  }

  .card:hover {
    border-color: hsl(var(--input));
  }

  .card-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--ak-radius-md);
    background: hsl(var(--ak-neutral-800));
    color: hsl(var(--primary-accent));
    margin-bottom: var(--ak-space-4);
  }

  h3 {
    font-size: var(--ak-text-lg);
    font-weight: 600;
    color: hsl(var(--foreground));
  }

  .card p {
    margin-top: var(--ak-space-3);
    font-size: var(--ak-text-sm);
    color: hsl(var(--ak-neutral-300));
    line-height: var(--ak-leading-relaxed);
  }

  /* Security Posture & Architectural Fit Strip */
  .posture-grid {
    margin-top: var(--ak-space-10);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--ak-space-6);
    scroll-margin-top: 5.5rem;
  }

  .posture-card {
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    padding: var(--ak-space-6);
    display: flex;
    flex-direction: column;
  }

  .posture-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ak-space-3);
    margin-bottom: var(--ak-space-3);
  }

  .posture-tag {
    font-size: var(--ak-text-xs);
    font-family: var(--ak-font-mono);
    font-weight: 600;
    color: hsl(var(--primary-accent));
    letter-spacing: var(--ak-tracking-wide);
  }

  .posture-pill {
    font-size: var(--ak-text-xs);
    font-family: var(--ak-font-mono);
    padding: 2px 8px;
    border-radius: var(--ak-radius-sm);
    background: hsl(var(--ak-neutral-800));
    color: hsl(var(--ak-neutral-200));
  }

  .posture-list {
    margin-top: var(--ak-space-4);
    display: flex;
    flex-direction: column;
    gap: var(--ak-space-3);
    list-style: none;
    padding: 0;
  }

  .posture-list li {
    font-size: var(--ak-text-sm);
    color: hsl(var(--ak-neutral-300));
    line-height: var(--ak-leading-relaxed);
  }

  .posture-list strong {
    color: hsl(var(--foreground));
    font-weight: 600;
  }

  .posture-list a {
    color: hsl(var(--primary-accent));
    font-weight: 500;
    margin-left: var(--ak-space-1);
  }

  .posture-list a:hover {
    text-decoration: underline;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .posture-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .why {
      padding: var(--ak-space-16) var(--ak-space-4);
    }
    .grid {
      grid-template-columns: 1fr;
      gap: var(--ak-space-4);
    }
  }
</style>
