---
import Icon from './Icon.astro';

const badges = [
  { icon: 'shield-check', label: 'OAuth 2.1 & OIDC Compliant', sub: 'RFC 6749 · 8693 · 8705 · 9449 · 9728' },
  { icon: 'fingerprint', label: 'WebAuthn Level 3', sub: 'FIDO2 Passkeys & Re-Proof Gating' },
  { icon: 'key', label: 'RFC 8785 JCS Binding', sub: 'Cryptographic HITL Step-Up Challenge' },
  { icon: 'square-function', label: 'Typestate Compile-Time Safe', sub: 'Zero Missing-Store Runtime Panics' },
  { icon: 'bot', label: 'Zero-Trust MCP Tool Guard', sub: 'Delegated Auth & Downstream Vault' },
  { icon: 'cpu', label: 'Memory-Safe Pure Rust', sub: 'Native Axum & Actix-Web Adapters' },
];
---
<section class="hero" id="top">
  <div class="grid-texture" aria-hidden="true"></div>
  <div class="inner">
    <h1>The Compile-Time Safe Identity &amp; AI Agent Authorization Engine for Rust</h1>
    <p class="lead">
      Orchestrate OAuth 2.1 Provider, Client, and Resource Server roles, Passkeys, and AWS Cedar
      policies behind a single Rust engine — coupled with production Model Context Protocol (MCP)
      tool security, cryptographic HITL step-up approval, and zero-trust downstream token brokers.
      A configuration that doesn't hold together simply won't compile.
    </p>

    <div class="ctas">
      <a class="btn primary" href="#quickstart">Read the Quickstart</a>
      <a class="btn secondary" href="#ai-agents-mcp">Explore MCP Security</a>
      <a class="btn ghost" href="https://play.authkestra.com" target="_blank" rel="noopener noreferrer">Playground</a>
    </div>

    <!-- Terminal Snippet -->
    <div class="terminal-box">
      <div class="terminal-bar">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>
        <span class="terminal-title">Terminal</span>
      </div>
      <div class="terminal-content">
        <span class="prompt">$</span>
        <code class="cmd">cargo add authkestra</code>
        <button class="copy-btn" id="hero-copy-btn" aria-label="Copy to clipboard" title="Copy to clipboard">
          <Icon name="copy" size={16} class="copy-icon" aria-hidden="true" />
          <Icon name="check" size={16} class="check-icon visually-hidden" aria-hidden="true" />
          <span class="copy-label">Copy</span>
        </button>
      </div>
    </div>

    <!-- Trust Badges -->
    <div class="badges-grid">
      {badges.map((b) => (
        <div class="badge-card">
          <div class="badge-icon-wrap">
            <Icon name={b.icon} size={20} class="badge-icon" aria-hidden="true" />
          </div>
          <div class="badge-text">
            <span class="badge-title">{b.label}</span>
            <span class="badge-sub">{b.sub}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('hero-copy-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('cargo add authkestra');
        const copyIcon = copyBtn.querySelector('.copy-icon');
        const checkIcon = copyBtn.querySelector('.check-icon');
        const label = copyBtn.querySelector('.copy-label');
        if (copyIcon && checkIcon && label) {
          copyIcon.classList.add('visually-hidden');
          checkIcon.classList.remove('visually-hidden');
          label.textContent = 'Copied!';
          setTimeout(() => {
            copyIcon.classList.remove('visually-hidden');
            checkIcon.classList.add('visually-hidden');
            label.textContent = 'Copy';
          }, 2000);
        }
      } catch (err) {
        console.error('Failed to copy to clipboard', err);
      }
    });
  }
</script>

<style>
  .hero {
    position: relative;
    max-width: var(--ak-layout-max);
    margin: 0 auto;
    padding: var(--ak-space-24) var(--ak-space-6) var(--ak-space-16);
    overflow: hidden;
  }

  .grid-texture {
    position: absolute;
    inset: -10% -10% auto -10%;
    height: 520px;
    background-image:
      linear-gradient(hsl(var(--border) / 0.5) 1px, transparent 1px),
      linear-gradient(90deg, hsl(var(--border) / 0.5) 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, black 40%, transparent 80%);
    mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, black 40%, transparent 80%);
    pointer-events: none;
    z-index: 0;
  }

  .inner {
    position: relative;
    z-index: 1;
  }

  h1 {
    font-size: var(--ak-text-4xl);
    max-width: 32ch;
    line-height: var(--ak-leading-tight);
    letter-spacing: var(--ak-tracking-tight);
  }

  .lead {
    margin-top: var(--ak-space-6);
    font-size: var(--ak-text-lg);
    line-height: var(--ak-leading-relaxed);
    color: hsl(var(--muted-foreground));
    max-width: 68ch;
  }

  .ctas {
    margin-top: var(--ak-space-8);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ak-space-4);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 var(--ak-space-6);
    border-radius: var(--radius);
    font-size: var(--ak-text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: all var(--ak-duration-fast) var(--ak-ease-out);
  }

  .btn.primary {
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    box-shadow: var(--ak-shadow-accent);
  }

  .btn.primary:hover {
    filter: brightness(1.08);
  }

  .btn.secondary {
    background: hsl(var(--card));
    color: hsl(var(--foreground));
    border: 1px solid hsl(var(--border));
  }

  .btn.secondary:hover {
    border-color: hsl(var(--input));
    background: hsl(var(--popover));
  }

  .btn.ghost {
    background: transparent;
    color: hsl(var(--muted-foreground));
    border: 1px solid transparent;
  }

  .btn.ghost:hover {
    color: hsl(var(--foreground));
    background: hsl(var(--card) / 0.5);
  }

  /* Terminal Snippet Container */
  .terminal-box {
    margin-top: var(--ak-space-8);
    max-width: 480px;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--ak-radius-md);
    overflow: hidden;
    box-shadow: var(--ak-shadow-2);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: var(--ak-space-2);
    padding: var(--ak-space-2) var(--ak-space-4);
    background: hsl(var(--ak-neutral-900));
    border-bottom: 1px solid hsl(var(--border));
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: var(--ak-radius-full);
  }

  .dot.red { background: hsl(var(--destructive)); }
  .dot.yellow { background: hsl(var(--warning)); }
  .dot.green { background: hsl(var(--success)); }

  .terminal-title {
    margin-left: var(--ak-space-2);
    font-size: var(--ak-text-2xs);
    font-family: var(--ak-font-mono);
    color: hsl(var(--muted-foreground));
    letter-spacing: var(--ak-tracking-wide);
    text-transform: uppercase;
  }

  .terminal-content {
    display: flex;
    align-items: center;
    padding: var(--ak-space-3) var(--ak-space-4);
    font-family: var(--ak-font-mono);
    font-size: var(--ak-text-sm);
  }

  .prompt {
    color: hsl(var(--primary-accent));
    margin-right: var(--ak-space-3);
    user-select: none;
  }

  .cmd {
    flex: 1;
    color: hsl(var(--foreground));
    font-family: inherit;
    font-size: inherit;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--ak-space-2);
    background: hsl(var(--muted));
    border: 1px solid hsl(var(--border));
    border-radius: var(--ak-radius-sm);
    color: hsl(var(--muted-foreground));
    padding: var(--ak-space-1) var(--ak-space-3);
    font-size: var(--ak-text-xs);
    font-family: var(--ak-font-sans);
    cursor: pointer;
    transition: all var(--ak-duration-fast) var(--ak-ease-out);
  }

  .copy-btn:hover {
    color: hsl(var(--foreground));
    border-color: hsl(var(--input));
    background: hsl(var(--accent));
  }

  .copy-btn :global(.check-icon) {
    color: hsl(var(--success-foreground));
  }

  /* Badges Grid */
  .badges-grid {
    margin-top: var(--ak-space-12);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--ak-space-4);
  }

  .badge-card {
    display: flex;
    align-items: flex-start;
    gap: var(--ak-space-3);
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    padding: var(--ak-space-4);
    transition: border-color var(--ak-duration-fast) var(--ak-ease-out);
  }

  .badge-card:hover {
    border-color: hsl(var(--input));
  }

  .badge-icon-wrap {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--ak-radius-sm);
    background: hsl(var(--ak-neutral-800));
    color: hsl(var(--primary-accent));
  }

  .badge-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .badge-title {
    font-size: var(--ak-text-sm);
    font-weight: 600;
    color: hsl(var(--foreground));
  }

  .badge-sub {
    margin-top: 2px;
    font-size: var(--ak-text-xs);
    color: hsl(var(--muted-foreground));
    line-height: var(--ak-leading-snug);
  }

  @media (min-width: 900px) {
    h1 {
      font-size: var(--ak-text-5xl);
    }
  }

  @media (max-width: 960px) {
    .badges-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: var(--ak-space-16) var(--ak-space-4) var(--ak-space-8);
    }
    .grid-texture {
      height: 360px;
    }
    .badges-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
