---
import Icon from './Icon.astro';

const tiers = [
  {
    tier: 'Tier 1',
    name: 'Public Tool Access',
    badge: 'Open / Context-Aware',
    icon: 'circle-check',
    diagram: 'tier1',
    desc: 'Callable without credentials or with optional caller identity context. Ideal for read-only lookups, health checks, and public documentation queries.',
    features: [
      'Zero credential overhead for read-only tools',
      'Optional caller identity context injection',
      'Structured audit logging & rate-limit hooks',
      'Direct JSON-RPC handler dispatch',
    ],
  },
  {
    tier: 'Tier 2',
    name: 'Scoped Resource Guard',
    badge: 'OAuth 2.1 · DPoP',
    icon: 'shield-check',
    diagram: 'tier2',
    desc: 'Requires a verified OAuth 2.1 bearer or sender-bound token. Missing scopes return standard resource metadata discovery challenges automatically.',
    features: [
      'Protected resource metadata (/.well-known)',
      'Sender-bound tokens (DPoP & mTLS)',
      'Declarative AWS Cedar policy evaluation',
      'Automatic 401 scope challenge elicitation',
    ],
  },
  {
    tier: 'Tier 3',
    name: 'Human-Approved Step-Up',
    badge: 'JCS · Passkey Proof',
    icon: 'key',
    diagram: 'tier3',
    desc: 'Mandates human passkey or TOTP approval cryptographically bound to the exact tool arguments before executing transfers, writes, or deletions.',
    features: [
      'Canonical JSON argument hashing (RFC 8785 JCS)',
      'Deterministic SHA-256 challenge digest binding',
      'WebAuthn Passkey or TOTP step-up verification',
      'Single-use atomic execution token consumption',
    ],
  },
];
---
<section id="ai-mcp-security" class="ai-mcp" aria-labelledby="ai-mcp-heading">
  <span id="ai-agents-mcp" class="anchor-alias" aria-hidden="true"></span>
  <div class="inner">
    <div class="header">
      <div class="pill">
        <Icon name="bot" size={16} class="pill-icon" aria-hidden="true" />
        <span>authkestra-mcp</span>
      </div>
      <h2 id="ai-mcp-heading">AI Agent &amp; Model Context Protocol (MCP) Security</h2>
      <p class="lead">
        Autonomous AI agents need access to tools, but giving models unrestricted execution rights
        or raw API keys crosses a critical security boundary. <code>authkestra-mcp</code> intercepts
        MCP JSON-RPC requests with three composable security tiers, cryptographic parameter binding,
        and server-side credential isolation.
      </p>
    </div>

    <!-- 3-Tier Grid with Legible 2D Animated SVGs -->
    <div class="tiers-grid">
      {tiers.map((t) => (
        <div class="tier-card">
          <div class="tier-header">
            <span class="tier-num">{t.tier}</span>
            <span class="tier-badge">{t.badge}</span>
          </div>

          <div class="tier-title-row">
            <div class="tier-icon-wrap">
              <Icon name={t.icon} size={20} class="tier-icon" aria-hidden="true" />
            </div>
            <h3>{t.name}</h3>
          </div>

          <!-- 2D Animated SVG Diagram for Tier (Scaled-up legible labels) -->
          <div class="tier-diagram-wrap">
            {t.diagram === 'tier1' && (
              <svg class="tier-diagram svg-tier-1" viewBox="0 0 320 116" role="img" aria-label="Tier 1 Public Tool Conduit">
                <path class="t-rail" d="M44,56 L276,56" />
                <path class="t-stream stream-tier-1" d="M44,56 L276,56" />
                <path class="t-tap" d="M160,26 L160,56" />
                <circle cx="160" cy="26" r="5" class="t-tap-dot" />
                <text x="160" y="16" class="t-diagram-caption" text-anchor="middle">Context Tap</text>

                <circle class="t-particle t-p1" r="4" cy="56" />
                <circle class="t-particle t-p2" r="4" cy="56" />

                <g transform="translate(44, 56)">
                  <circle r="20" class="t-node-chip" />
                  <text x="0" y="4" class="t-node-glyph" text-anchor="middle">Agent</text>
                  <text x="0" y="34" class="t-diagram-sub" text-anchor="middle">Caller</text>
                </g>
                <g transform="translate(276, 56)">
                  <circle r="20" class="t-node-chip t-node-success" />
                  <text x="0" y="4" class="t-node-glyph t-glyph-success" text-anchor="middle">Tool</text>
                  <text x="0" y="34" class="t-diagram-sub" text-anchor="middle">Public</text>
                </g>
              </svg>
            )}

            {t.diagram === 'tier2' && (
              <svg class="tier-diagram svg-tier-2" viewBox="0 0 320 116" role="img" aria-label="Tier 2 Scoped Resource Guard">
                <path class="t-rail" d="M44,56 L134,56" />
                <path class="t-rail" d="M186,56 L276,56" />
                <path class="t-stream stream-tier-2" d="M186,56 L276,56" />

                <g class="t-gate" transform="translate(160, 56)">
                  <circle r="24" class="t-gate-aura" />
                  <rect x="-24" y="-14" width="48" height="28" rx="6" class="t-shield" />
                  <text x="0" y="4" class="t-gate-text" text-anchor="middle">DPoP</text>
                  <text x="0" y="34" class="t-diagram-sub" text-anchor="middle">Scope Check</text>
                </g>

                <circle class="t-particle t-p-scoped-in" r="4" cy="56" />
                <circle class="t-particle t-p-scoped-out" r="4" cy="56" />

                <g transform="translate(44, 56)">
                  <circle r="20" class="t-node-chip" />
                  <text x="0" y="4" class="t-node-glyph" text-anchor="middle">Token</text>
                  <text x="0" y="34" class="t-diagram-sub" text-anchor="middle">OAuth 2.1</text>
                </g>
                <g transform="translate(276, 56)">
                  <circle r="20" class="t-node-chip t-node-success" />
                  <text x="0" y="4" class="t-node-glyph t-glyph-success" text-anchor="middle">Tool</text>
                  <text x="0" y="34" class="t-diagram-sub" text-anchor="middle">Scoped</text>
                </g>
              </svg>
            )}

            {t.diagram === 'tier3' && (
              <svg class="tier-diagram svg-tier-3" viewBox="0 0 320 116" role="img" aria-label="Tier 3 Human-Approved Step-Up">
                <path class="t-rail" d="M42,56 L92,56" />
                <path class="t-rail t-rail-bridge" d="M138,56 L182,56" />
                <path class="t-stream stream-tier-3" d="M228,56 L278,56" />

                <g class="t-lock-node" transform="translate(115, 56)">
                  <rect x="-21" y="-14" width="42" height="28" rx="6" class="t-lock-body" />
                  <text x="0" y="4" class="t-lock-label" text-anchor="middle">JCS</text>
                  <text x="0" y="34" class="t-diagram-sub" text-anchor="middle">SHA-256</text>
                </g>

                <g class="t-bio-node" transform="translate(205, 56)">
                  <circle r="23" class="t-bio-wave wave-a" />
                  <circle r="32" class="t-bio-wave wave-b" />
                  <circle r="20" class="t-bio-chip" />
                  <text x="0" y="4" class="t-bio-glyph" text-anchor="middle">FIDO2</text>
                  <text x="0" y="34" class="t-diagram-sub" text-anchor="middle">Passkey</text>
                </g>

                <g transform="translate(42, 56)">
                  <circle r="20" class="t-node-chip" />
                  <text x="0" y="4" class="t-node-glyph" text-anchor="middle">Agent</text>
                  <text x="0" y="34" class="t-diagram-sub" text-anchor="middle">Call</text>
                </g>
                <g transform="translate(278, 56)">
                  <circle r="20" class="t-node-chip t-node-success" />
                  <text x="0" y="4" class="t-node-glyph t-glyph-success" text-anchor="middle">Exec</text>
                  <text x="0" y="34" class="t-diagram-sub" text-anchor="middle">Verified</text>
                </g>
              </svg>
            )}
          </div>

          <p class="tier-desc">{t.desc}</p>
          <ul class="tier-features">
            {t.features.map((f) => (
              <li>
                <Icon name="check" size={15} class="feature-check" aria-hidden="true" />
                <span>{f}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Deep Dive Architecture: JCS Parameter Binding, Token Vault, & Typestate Guardrails -->
    <div class="architecture-grid">
      <!-- Card 1: JCS Parameter Binding -->
      <div class="arch-card">
        <div class="arch-icon-wrap">
          <Icon name="shield-alert" size={22} class="arch-icon" aria-hidden="true" />
        </div>
        <h3>JCS Parameter Tampering Defense</h3>
        <p>
          Prompt injections and model hallucinations can alter critical arguments after a user
          approves an action. Authkestra binds approvals using <strong>RFC 8785 JSON
          Canonicalization Scheme (JCS)</strong>:
        </p>
        <div class="formula-box" role="region" aria-label="JCS challenge digest formula">
          <code>SHA-256(session_id ‖ tool_name ‖ JCS(args) ‖ expires_at)</code>
        </div>
        <p class="arch-foot">
          If an agent mutates even one field or numeric value (e.g., <code>amount: 50</code> →
          <code>5000</code>) between approval and execution, the digest check fails and aborts the call.
        </p>
      </div>

      <!-- Card 2: Zero-Trust Token Vault -->
      <div class="arch-card">
        <div class="arch-icon-wrap">
          <Icon name="lock" size={22} class="arch-icon" aria-hidden="true" />
        </div>
        <h3>Zero-Trust Downstream Token Vault</h3>
        <p>
          Keep OAuth2 refresh tokens, client secrets, and third-party API keys out of the LLM
          prompt context with <code>DownstreamTokenBroker</code> and <code>EncryptedKvTokenVault</code>:
        </p>
        <ul class="arch-list">
          <li>Credentials are encrypted at rest with AES-256-GCM envelope keys.</li>
          <li>Handlers receive an isolated <code>ToolContext</code> bound to the verified caller.</li>
          <li>Short-lived downstream tokens are dispensed just-in-time on the server.</li>
        </ul>
        <div class="vault-pipeline" aria-label="Token vault isolation flow">
          <code>Agent Context (No Secrets) → Broker → AES-256-GCM Vault</code>
        </div>
      </div>

      <!-- Card 3: Typestate Compiler Guardrails -->
      <div class="arch-card">
        <div class="arch-icon-wrap">
          <Icon name="square-function" size={22} class="arch-icon" aria-hidden="true" />
        </div>
        <h3>Typestate Compiler Guardrails</h3>
        <p>
          Whether written by hand or generated by an AI assistant, missing session stores or
          unconfigured token validators fail at <code>cargo check</code> via <code>Engine&lt;S, T&gt;</code>:
        </p>

        <!-- Clean, Non-Overlapping 2D Animated Typestate Guardrail SVG -->
        <div class="typestate-diagram-wrap">
          <svg class="typestate-diagram" viewBox="0 0 340 148" role="img" aria-label="Typestate Compiler Guardrail Diagram">
            <!-- Top Lane: Incomplete Config Halted at Compile-Time -->
            <g class="lane lane-halted" transform="translate(0, 44)">
              <text x="16" y="-20" class="lane-title">Incomplete Builder</text>
              <text x="324" y="-20" class="barrier-title" text-anchor="end">error[E0277]</text>

              <path class="lane-rail" d="M32,0 L164,0" />
              <circle class="lane-particle particle-halt" r="4" cy="0" />

              <g transform="translate(32, 0)">
                <circle r="14" class="lane-node node-halt" />
                <text x="0" y="4" class="lane-node-text" text-anchor="middle">S1</text>
              </g>

              <g class="barrier" transform="translate(164, 0)">
                <rect x="-4" y="-12" width="8" height="24" rx="2" class="barrier-wall" />
                <text x="14" y="4" class="barrier-sub">MissingStore</text>
              </g>
            </g>

            <!-- Bottom Lane: Complete Typestate Verified by rustc -->
            <g class="lane lane-verified" transform="translate(0, 116)">
              <text x="16" y="-20" class="lane-title ok">Engine&lt;Ready, Verified&gt;</text>
              <text x="324" y="-20" class="gateway-tag" text-anchor="end">rustc verified</text>

              <path class="lane-rail" d="M32,0 L296,0" />
              <path class="lane-stream" d="M32,0 L296,0" />
              <circle class="lane-particle particle-pass" r="4" cy="0" />

              <g transform="translate(32, 0)">
                <circle r="14" class="lane-node node-ok" />
                <text x="0" y="4" class="lane-node-text" text-anchor="middle">S2</text>
              </g>

              <g class="gateway" transform="translate(164, 0)">
                <rect x="-4" y="-12" width="8" height="24" rx="2" class="gateway-post" />
              </g>

              <g transform="translate(296, 0)">
                <circle r="14" class="lane-node node-prod" />
                <text x="0" y="4" class="lane-node-text text-success" text-anchor="middle">✓</text>
              </g>
            </g>
          </svg>
        </div>

        <p class="arch-foot">
          Misconfigured builders fail to compile instead of panicking on missing stores at runtime.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .ai-mcp {
    max-width: var(--ak-layout-max);
    margin: 0 auto;
    padding: var(--ak-space-24) var(--ak-space-6);
    position: relative;
  }

  .anchor-alias {
    position: absolute;
    top: 0;
    left: 0;
    visibility: hidden;
  }

  .inner {
    position: relative;
  }

  .header {
    max-width: 72ch;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--ak-space-2);
    padding: var(--ak-space-1) var(--ak-space-3);
    border-radius: var(--ak-radius-full);
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    font-size: var(--ak-text-xs);
    font-family: var(--ak-font-mono);
    color: hsl(var(--primary-accent));
    margin-bottom: var(--ak-space-4);
  }

  .pill-icon {
    color: hsl(var(--primary-accent));
  }

  h2 {
    font-size: var(--ak-text-3xl);
    letter-spacing: var(--ak-tracking-tight);
    color: hsl(var(--foreground));
  }

  .lead {
    margin-top: var(--ak-space-4);
    font-size: var(--ak-text-lg);
    line-height: var(--ak-leading-relaxed);
    color: hsl(var(--ak-neutral-300));
  }

  /* Tiers Grid */
  .tiers-grid {
    margin-top: var(--ak-space-12);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--ak-space-6);
    align-items: stretch;
  }

  .tier-card {
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    padding: var(--ak-space-6);
    display: flex;
    flex-direction: column;
    transition: border-color var(--ak-duration-fast) var(--ak-ease-out);
  }

  .tier-card:hover {
    border-color: hsl(var(--input));
  }

  .tier-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--ak-space-4);
  }

  .tier-num {
    font-size: var(--ak-text-xs);
    font-family: var(--ak-font-mono);
    font-weight: 600;
    color: hsl(var(--primary-accent));
    text-transform: uppercase;
    letter-spacing: var(--ak-tracking-wide);
  }

  .tier-badge {
    font-size: var(--ak-text-xs);
    background: hsl(var(--ak-neutral-800));
    color: hsl(var(--ak-neutral-200));
    padding: 2px 8px;
    border-radius: var(--ak-radius-sm);
    font-family: var(--ak-font-mono);
  }

  .tier-title-row {
    display: flex;
    align-items: center;
    gap: var(--ak-space-3);
    margin-bottom: var(--ak-space-4);
  }

  .tier-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--ak-radius-sm);
    background: hsl(var(--ak-neutral-800));
    color: hsl(var(--primary-accent));
    flex-shrink: 0;
  }

  .tier-card h3 {
    font-size: var(--ak-text-lg);
    font-weight: 600;
    color: hsl(var(--foreground));
  }

  /* 2D Animated Diagram Wrappers */
  .tier-diagram-wrap {
    margin-bottom: var(--ak-space-5);
    background: hsl(var(--ak-neutral-950));
    border: 1px solid hsl(var(--border));
    border-radius: var(--ak-radius-md);
    padding: var(--ak-space-3);
    overflow: hidden;
  }

  .tier-diagram {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Shared SVG Diagram Styles (Scaled up to 10.5px-11.5px for clear legibility) */
  .t-rail {
    fill: none;
    stroke: hsl(var(--border));
    stroke-width: 2;
  }

  .t-stream {
    fill: none;
    stroke: hsl(var(--primary-accent));
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 40 80;
    animation: tierStreamFlow 2.5s linear infinite;
  }

  @keyframes tierStreamFlow {
    0% { stroke-dashoffset: 120; opacity: 0.3; }
    50% { opacity: 1; }
    100% { stroke-dashoffset: -120; opacity: 0.3; }
  }

  .t-tap {
    stroke: hsl(var(--primary) / 0.7);
    stroke-width: 1.5;
    stroke-dasharray: 2 3;
  }

  .t-tap-dot {
    fill: hsl(var(--primary-accent));
  }

  .t-diagram-caption {
    font-size: 11px;
    font-family: var(--ak-font-mono);
    fill: hsl(var(--primary-accent));
    font-weight: 600;
  }

  .t-diagram-sub {
    font-size: 10.5px;
    font-family: var(--ak-font-mono);
    fill: hsl(var(--ak-neutral-300));
  }

  .t-node-chip {
    fill: hsl(var(--card));
    stroke: hsl(var(--input));
    stroke-width: 1.5;
  }

  .t-node-success {
    stroke: hsl(var(--success-foreground));
    fill: hsl(var(--primary-subtle) / 0.5);
  }

  .t-node-glyph {
    font-size: 10.5px;
    font-family: var(--ak-font-mono);
    font-weight: 700;
    fill: hsl(var(--foreground));
  }

  .t-glyph-success {
    fill: hsl(var(--success-foreground));
  }

  .t-particle {
    fill: hsl(var(--primary-accent));
    filter: drop-shadow(0 0 4px hsl(var(--primary-accent) / 0.8));
    animation: particleTravel 2.4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .t-p1 { animation-delay: 0s; }
  .t-p2 { animation-delay: 1.2s; }

  @keyframes particleTravel {
    0% { cx: 44px; opacity: 0; }
    15% { opacity: 1; }
    85% { opacity: 1; }
    100% { cx: 276px; opacity: 0; }
  }

  /* Tier 2 Gate Shield */
  .t-gate-aura {
    fill: hsl(var(--primary-subtle) / 0.4);
    stroke: hsl(var(--primary-accent) / 0.5);
    stroke-width: 1.5;
    animation: gatePulse 2s ease-in-out infinite;
  }

  @keyframes gatePulse {
    0%, 100% { r: 22px; opacity: 0.5; }
    50% { r: 26px; opacity: 1; }
  }

  .t-shield {
    fill: hsl(var(--card));
    stroke: hsl(var(--primary-accent));
    stroke-width: 1.5;
  }

  .t-gate-text {
    font-size: 11px;
    font-family: var(--ak-font-mono);
    font-weight: 700;
    fill: hsl(var(--primary-accent));
  }

  .t-p-scoped-in {
    animation: particleScopedIn 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .t-p-scoped-out {
    animation: particleScopedOut 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    animation-delay: 1s;
  }

  @keyframes particleScopedIn {
    0% { cx: 44px; opacity: 0; }
    20% { opacity: 1; }
    90% { opacity: 1; }
    100% { cx: 134px; opacity: 0; }
  }

  @keyframes particleScopedOut {
    0% { cx: 186px; opacity: 0; }
    20% { opacity: 1; }
    90% { opacity: 1; }
    100% { cx: 276px; opacity: 0; }
  }

  /* Tier 3 JCS Lock and Biometrics */
  .t-lock-body {
    fill: hsl(var(--ak-neutral-800));
    stroke: hsl(var(--primary-accent));
    stroke-width: 1.5;
  }

  .t-lock-label {
    font-size: 11px;
    font-family: var(--ak-font-mono);
    font-weight: 700;
    fill: hsl(var(--primary-accent));
  }

  .t-bio-chip {
    fill: hsl(var(--card));
    stroke: hsl(var(--primary-accent));
    stroke-width: 1.5;
  }

  .t-bio-glyph {
    font-size: 10px;
    font-family: var(--ak-font-mono);
    font-weight: 700;
    fill: hsl(var(--primary-accent));
  }

  .t-bio-wave {
    fill: none;
    stroke: hsl(var(--primary-accent));
    stroke-width: 1.2;
    opacity: 0;
    animation: bioPulseWave 2.4s cubic-bezier(0.1, 0.7, 0.3, 1) infinite;
  }

  .wave-b { animation-delay: 1.2s; }

  @keyframes bioPulseWave {
    0% { r: 20px; opacity: 0.9; stroke-width: 1.5px; }
    100% { r: 36px; opacity: 0; stroke-width: 0.5px; }
  }

  .t-rail-bridge {
    stroke: hsl(var(--primary-accent) / 0.5);
    stroke-dasharray: 3 3;
  }

  .tier-desc {
    font-size: var(--ak-text-sm);
    color: hsl(var(--ak-neutral-300));
    line-height: var(--ak-leading-relaxed);
    margin-bottom: var(--ak-space-5);
  }

  .tier-features {
    margin-top: auto;
    padding-top: var(--ak-space-4);
    border-top: 1px solid hsl(var(--border));
    display: flex;
    flex-direction: column;
    gap: var(--ak-space-2);
    list-style: none;
    padding-left: 0;
  }

  .tier-features li {
    display: flex;
    align-items: flex-start;
    gap: var(--ak-space-2);
    font-size: var(--ak-text-sm);
    color: hsl(var(--ak-neutral-200));
    line-height: var(--ak-leading-snug);
  }

  .feature-check {
    color: hsl(var(--success-foreground));
    flex-shrink: 0;
    margin-top: 3px;
  }

  /* Architecture Sub-Grid */
  .architecture-grid {
    margin-top: var(--ak-space-12);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--ak-space-6);
    align-items: stretch;
  }

  .arch-card {
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    padding: var(--ak-space-6);
    display: flex;
    flex-direction: column;
  }

  .arch-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--ak-radius-md);
    background: hsl(var(--ak-neutral-800));
    color: hsl(var(--primary-accent));
    margin-bottom: var(--ak-space-4);
  }

