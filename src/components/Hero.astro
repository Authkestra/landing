---
import Icon from './Icon.astro';
---
<section class="hero" id="top">
  <div class="grid-texture" aria-hidden="true"></div>
  <div class="inner">
    <div class="hero-copy">
      <a href="#security-posture" class="posture">v0.13, pre-1.0. Read the security posture</a>

      <h1>Your security can't be hallucinated.</h1>
      <p class="lead">
        An embedded identity and AI agent authorization engine for Rust. Checked at compile time,
        with no sidecar to run.
      </p>

      <div class="ctas">
        <a class="btn primary" href="#quickstart">Quickstart</a>
        <a class="btn secondary" href="https://docs.authkestra.com">Documentation</a>
        <a class="btn ghost" href="https://play.authkestra.com" target="_blank" rel="noopener noreferrer">Playground</a>
      </div>

      <div class="install">
        <span class="prompt" aria-hidden="true">$</span>
        <code class="cmd">cargo add authkestra</code>
        <button class="copy-btn" id="hero-copy-btn" aria-label="Copy install command" title="Copy install command">
          <Icon name="copy" size={16} class="copy-icon" aria-hidden="true" />
          <Icon name="check" size={16} class="check-icon visually-hidden" aria-hidden="true" />
          <span class="copy-label">Copy</span>
        </button>
      </div>
    </div>

    <figure class="tamper" aria-label="An agent changes an approved amount and the call is blocked">
      <figcaption>transfer_funds</figcaption>
      <div class="row ok">
        <span class="who">You approved</span>
        <span class="amount">$50</span>
        <span class="verdict"><Icon name="check" size={16} aria-hidden="true" /> Matches</span>
      </div>
      <div class="link" aria-hidden="true"></div>
      <div class="row bad">
        <span class="who">Agent sent</span>
        <span class="amount">$5,000</span>
        <span class="verdict"><Icon name="shield-alert" size={16} aria-hidden="true" /> Blocked</span>
      </div>
    </figure>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('hero-copy-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('cargo add authkestra');
        const copyIcon = copyBtn.querySelector('.copy-icon');
        const checkIcon = copyBtn.querySelector('.check-icon');
        const label = copyBtn.querySelector('.copy-label');
        if (copyIcon && checkIcon && label) {
          copyIcon.classList.add('visually-hidden');
          checkIcon.classList.remove('visually-hidden');
          label.textContent = 'Copied';
          setTimeout(() => {
            copyIcon.classList.remove('visually-hidden');
            checkIcon.classList.add('visually-hidden');
            label.textContent = 'Copy';
          }, 2000);
        }
      } catch (err) {
        console.error('Failed to copy to clipboard', err);
      }
    });
  }
</script>

<style>
  .hero {
    position: relative;
    max-width: var(--ak-layout-max);
    margin: 0 auto;
    padding: var(--ak-space-16) var(--ak-space-6) var(--ak-space-16);
    overflow: hidden;
  }

  .grid-texture {
    position: absolute;
    inset: -10% -10% auto -10%;
    height: 520px;
    background-image:
      linear-gradient(hsl(var(--border) / 0.5) 1px, transparent 1px),
      linear-gradient(90deg, hsl(var(--border) / 0.5) 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 0%, black 40%, transparent 80%);
    mask-image: radial-gradient(ellipse 75% 65% at 50% 0%, black 40%, transparent 80%);
    pointer-events: none;
  }

  .inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--ak-space-12);
    align-items: center;
  }

  .hero-copy,
  .tamper {
    min-width: 0;
  }

  .posture {
    display: inline-block;
    margin-bottom: var(--ak-space-5);
    font-size: var(--ak-text-sm);
    color: hsl(var(--primary-accent));
  }

  .posture:hover {
    text-decoration: underline;
  }

  h1 {
    font-size: var(--ak-text-4xl);
    line-height: var(--ak-leading-tight);
    letter-spacing: var(--ak-tracking-tight);
    max-width: 16ch;
  }

  .lead {
    margin-top: var(--ak-space-5);
    max-width: 46ch;
    font-size: var(--ak-text-lg);
    line-height: var(--ak-leading-relaxed);
    color: hsl(var(--ak-neutral-300));
  }

  .ctas {
    margin-top: var(--ak-space-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--ak-space-3);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 var(--ak-space-5);
    border-radius: var(--radius);
    font-size: var(--ak-text-sm);
    font-weight: 500;
    transition: all var(--ak-duration-fast) var(--ak-ease-out);
  }

  .btn.primary {
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    box-shadow: var(--ak-shadow-accent);
  }

  .btn.primary:hover { filter: brightness(1.08); }

  .btn.secondary {
    background: hsl(var(--card));
    color: hsl(var(--foreground));
    border: 1px solid hsl(var(--border));
  }

  .btn.secondary:hover { border-color: hsl(var(--input)); }

  .btn.ghost {
    color: hsl(var(--ak-neutral-300));
  }

  .btn.ghost:hover { color: hsl(var(--foreground)); }

  .install {
    margin-top: var(--ak-space-6);
    max-width: 420px;
    display: flex;
    align-items: center;
    gap: var(--ak-space-3);
    padding: var(--ak-space-2) var(--ak-space-2) var(--ak-space-2) var(--ak-space-4);
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--ak-radius-md);
    font-family: var(--ak-font-mono);
    font-size: var(--ak-text-sm);
  }

  .prompt {
    color: hsl(var(--primary-accent));
    user-select: none;
  }

  .cmd {
    flex: 1;
    color: hsl(var(--foreground));
    font: inherit;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--ak-space-2);
    background: hsl(var(--muted));
    border: 1px solid hsl(var(--border));
    border-radius: var(--ak-radius-sm);
    color: hsl(var(--ak-neutral-300));
    padding: var(--ak-space-1) var(--ak-space-3);
    font-size: var(--ak-text-xs);
    font-family: var(--ak-font-sans);
  }

  .copy-btn:hover {
    color: hsl(var(--foreground));
    border-color: hsl(var(--input));
  }

  .copy-btn :global(.check-icon) {
    color: hsl(var(--success-foreground));
  }

  /* The one memorable thing: an approved amount vs. what the agent sent */
  .tamper {
    margin: 0;
    padding: var(--ak-space-6);
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--ak-radius-xl);
    box-shadow: var(--ak-shadow-3);
  }

  .tamper figcaption {
    font-family: var(--ak-font-mono);
    font-size: var(--ak-text-sm);
    color: hsl(var(--muted-foreground));
    margin-bottom: var(--ak-space-5);
  }

  .row {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: var(--ak-space-4);
    padding: var(--ak-space-4) var(--ak-space-5);
    border: 1px solid hsl(var(--border));
    border-radius: var(--ak-radius-md);
    background: hsl(var(--ak-neutral-950));
  }

  .who {
    font-size: var(--ak-text-sm);
    color: hsl(var(--ak-neutral-300));
  }

  .amount {
    font-family: var(--ak-font-mono);
    font-size: var(--ak-text-xl);
    font-weight: 600;
    color: hsl(var(--foreground));
  }

  .verdict {
    display: inline-flex;
    align-items: center;
    gap: var(--ak-space-2);
    min-width: 96px;
    justify-content: flex-end;
    font-size: var(--ak-text-sm);
    font-weight: 500;
  }

  .row.ok .verdict { color: hsl(var(--success-foreground)); }

  .row.bad {
    border-color: hsl(var(--destructive) / 0.6);
  }

  .row.bad .amount {
    text-decoration: line-through;
    text-decoration-color: hsl(var(--destructive));
  }

  .row.bad .verdict { color: hsl(var(--destructive-muted)); }

  .link {
    width: 2px;
    height: var(--ak-space-5);
    margin: 0 auto;
    background: hsl(var(--border));
  }

  @media (max-width: 980px) {
    .inner {
      grid-template-columns: 1fr;
      gap: var(--ak-space-10);
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: var(--ak-space-12) var(--ak-space-4) var(--ak-space-10);
    }
    h1 { font-size: var(--ak-text-3xl); }
    .lead { font-size: var(--ak-text-base); }
    .ctas .btn { flex: 1 1 100%; }
    .install { max-width: none; }
    .tamper { padding: var(--ak-space-4); }
    .row {
      grid-template-columns: 1fr auto;
      row-gap: var(--ak-space-1);
    }
    .verdict {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }
  }
</style>
