---
import Icon from './Icon.astro';
---
<header class="nav">
  <nav class="bar" aria-label="Primary">
    <a class="wordmark" href="#top">
      <svg class="mark" width="22" height="22" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <path d="M5.5 27.5 16 5l10.5 22.5" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
        <rect x="10" y="17.6" width="12" height="2.8" rx="1.4" fill="hsl(var(--brand))" />
      </svg>
      authkestra
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Toggle navigation menu">
      <span class="bars" aria-hidden="true"></span>
    </button>

    <ul class="links" id="nav-links">
      <li><a href="#ai-mcp-security">MCP Security</a></li>
      <li><a href="#quickstart">Quickstart</a></li>
      <li><a href="https://docs.authkestra.com">Docs</a></li>
      <li><a href="https://authkestra.com/llms.txt">llms.txt</a></li>
      <li><a href="https://play.authkestra.com">Playground</a></li>
      <li>
        <a href="https://github.com/Authkestra/authkestra" class="gh" target="_blank" rel="noopener noreferrer">
          <Icon name="github" size={18} aria-hidden="true" />
          <span>GitHub</span>
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('.nav');
  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(!nav.classList.contains('open')));
    nav.querySelectorAll('.links a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: hsl(var(--background));
    background: hsl(var(--background) / 0.95);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid hsl(var(--border));
    box-shadow: 0 4px 20px -4px hsl(var(--ak-black) / 0.65);
  }

  .bar {
    max-width: var(--ak-layout-max);
    margin: 0 auto;
    padding: var(--ak-space-4) var(--ak-space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ak-space-4);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--ak-space-2);
    font-size: var(--ak-text-lg);
    font-weight: 600;
    color: hsl(var(--foreground));
    letter-spacing: var(--ak-tracking-tight);
  }

  /*
    The mark carries its own rust in the crossbar, so `color` here sets its
    ink — the two strokes — not the accent. Painting the whole glyph rust
    would make the crossbar vanish into it and lose the one part that means
    anything. This is still the only orange in the nav region.
  */
  .mark {
    color: hsl(var(--foreground));
    flex-shrink: 0;
  }

  .links {
    display: flex;
    align-items: center;
    gap: var(--ak-space-8);
    font-size: var(--ak-text-sm);
    font-weight: 500;
  }

  .links a {
    color: hsl(var(--muted-foreground));
    transition: color var(--ak-duration-fast) var(--ak-ease-out);
  }

  .links a:hover {
    color: hsl(var(--foreground));
  }

  .gh {
    display: inline-flex;
    align-items: center;
    gap: var(--ak-space-2);
  }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid hsl(var(--border));
    border-radius: var(--ak-radius-md);
  }

  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 18px;
    height: 2px;
    background: hsl(var(--foreground));
    border-radius: 1px;
    transition: transform var(--ak-duration-fast) var(--ak-ease-out), opacity var(--ak-duration-fast);
  }

  .bars {
    position: relative;
  }

  .bars::before,
  .bars::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .bars::before { top: -6px; }
  .bars::after { top: 6px; }

  .nav.open .bars { background: transparent; }
  .nav.open .bars::before { top: 0; transform: rotate(45deg); }
  .nav.open .bars::after { top: 0; transform: rotate(-45deg); }

  @media (max-width: 820px) {
    .bar {
      padding: var(--ak-space-3) var(--ak-space-4);
      flex-wrap: wrap;
    }
    .menu-toggle {
      display: inline-flex;
    }
    .links {
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      width: 100%;
      padding-top: var(--ak-space-2);
    }
    .nav.open .links {
      display: flex;
    }
    .links li a {
      display: flex;
      align-items: center;
      min-height: 44px;
      border-top: 1px solid hsl(var(--border));
    }
    .wordmark {
      font-size: var(--ak-text-base);
    }
  }
</style>
