---
import Icon from './Icon.astro';

const cards = [
  {
    icon: 'bot',
    title: 'AI Agent & MCP Tool Authorization',
    body: 'Native 3-tier security for Model Context Protocol tools, complete with RFC 8785 JCS parameter binding, Passkey step-up approvals, and a server-side token vault.',
  },
  {
    icon: 'shield',
    title: 'Typestate Compile-Time Safety',
    body: 'The typestate builder pattern turns missing stores or unconfigured validators into compile-time errors rather than runtime panics when requests hit production.',
  },
  {
    icon: 'feather',
    title: 'Stateless OAuth & Zero DB Dependency',
    body: 'OAuth state and PKCE verifiers live in AES-256-GCM encrypted cookies—allowing horizontal scaling across instances without a shared Redis or SQL session store.',
  },
  {
    icon: 'server',
    title: 'Tri-Role OAuth 2.1 Engine',
    body: 'Run an OpenID Provider (OP), Client (RP), and Resource Server (RS) from a single crate. Protect APIs with DPoP and mTLS proof-of-possession token binding.',
  },
  {
    icon: 'route',
    title: 'Fine-Grained Cedar Policy & CAEP',
    body: 'Evaluate declarative AWS Cedar authorization policies in microseconds, and ingest OpenID Shared Signals and Events (CAEP/SSF) to revoke sessions in real time.',
  },
  {
    icon: 'puzzle',
    title: 'Framework & Database Agnostic',
    body: 'The core engine is pure Rust logic. Axum and Actix-web are lightweight isolated adapters, and persistence is a trait you implement—no rigid schema forced on your database.',
  },
];
---
<section id="why" class="why" aria-labelledby="why-heading">
  <div class="inner">
    <h2 id="why-heading">Why Authkestra</h2>
    <p class="lead">
      Built for Rust teams who want cryptographic rigor, compile-time wiring guarantees,
      and zero operational sidecars across backend APIs and AI agent servers.
    </p>
    <div class="grid">
      {cards.map((c) => (
        <div class="card">
          <div class="card-icon-wrap">
            <Icon name={c.icon} size={24} class="card-icon" aria-hidden="true" />
          </div>
          <h3>{c.title}</h3>
          <p>{c.body}</p>
        </div>
      ))}
    </div>

    <!-- Trust Signals: Security Posture & Honest Architectural Trade-offs -->
    <div id="security-posture" class="posture-grid" aria-label="Security posture and architectural fit">
      <div class="posture-card">
        <div class="posture-header">
          <span class="posture-tag">STATUS &amp; SECURITY POSTURE</span>
          <span class="posture-pill">v0.13.1 · Pre-1.0</span>
        </div>
        <h3>Maturity, Cryptographic Stack &amp; Audit Status</h3>
        <ul class="posture-list">
          <li>
            <strong>Version &amp; MSRV:</strong> Active <code>0.13.x</code> release series
            (<code>Rust 2021</code>, MSRV <code>1.85</code>). Minor <code>0.x</code> updates may
            introduce documented API refinements prior to <code>1.0</code> stabilization.
          </li>
          <li>
            <strong>Audited Upstream Primitives:</strong> Built on battle-tested crates including
            <code>ring</code> / <code>aws-lc-rs</code>, <code>webauthn-rs</code>,
            <code>cedar-policy</code>, <code>argon2</code>, and <code>aes-gcm</code>.
          </li>
          <li>
            <strong>Verification &amp; Disclosure:</strong> Every commit runs adversarial AEAD/JCS
            tamper suites and <code>cargo-deny</code> supply-chain checks. A formal third-party
            audit is planned before <code>1.0</code>. See our
            <a href="https://github.com/Authkestra/authkestra/blob/main/SECURITY.md" target="_blank" rel="noopener noreferrer">Security Policy →</a>
          </li>
        </ul>
      </div>

      <div class="posture-card">
        <div class="posture-header">
          <span class="posture-tag">ARCHITECTURAL FIT</span>
          <span class="posture-pill">Embedded vs. Sidecar IdP</span>
        </div>
        <h3>When to Use (and Not Use) Authkestra</h3>
        <ul class="posture-list">
          <li>
            <strong>Use Authkestra when:</strong> You are building Rust APIs, web apps, or MCP
            servers that need in-process OAuth 2.1, Passkeys, Cedar policy, and step-up agent
            authorization without deploying a separate JVM or Go cluster.
          </li>
          <li>
            <strong>When not to use Authkestra:</strong> If you need a turnkey admin console for
            non-technical operators, legacy SAML 2.0 XML federation, or a polyglot workforce SSO
            portal across dozens of non-Rust apps.
          </li>
          <li>
            <strong>Hybrid Option:</strong> Keep <strong>Keycloak</strong>, <strong>Zitadel</strong>,
            or <strong>Ory</strong> as your upstream workforce IdP and connect Authkestra to it via
            <code>authkestra-oidc</code> discovery while using <code>authkestra-mcp</code> for Rust
            tool guards.
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .why {
    max-width: var(--ak-layout-max);
    margin: 0 auto;
    padding: var(--ak-space-24) var(--ak-space-6);
  }

  .inner {
    position: relative;
  }

  h2 {
    font-size: var(--ak-text-3xl);
    letter-spacing: var(--ak-tracking-tight);
  }

  .lead {
    margin-top: var(--ak-space-4);
    max-width: 68ch;
    font-size: var(--ak-text-lg);
    color: hsl(var(--ak-neutral-300));
    line-height: var(--ak-leading-relaxed);
  }

  .grid {
    margin-top: var(--ak-space-12);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--ak-space-6);
  }

  .card {
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    padding: var(--ak-space-6);
    transition: border-color var(--ak-duration-fast) var(--ak-ease-out);
  }

  .card:hover {
    border-color: hsl(var(--input));
  }

  .card-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--ak-radius-md);
    background: hsl(var(--ak-neutral-800));
    color: hsl(var(--primary-accent));
    margin-bottom: var(--ak-space-4);
  }

  h3 {
    font-size: var(--ak-text-lg);
    font-weight: 600;
    color: hsl(var(--foreground));
  }

  .card p {
    margin-top: var(--ak-space-3);
    font-size: var(--ak-text-sm);
    color: hsl(var(--ak-neutral-300));
    line-height: var(--ak-leading-relaxed);
  }

  /* Security Posture & Architectural Fit Strip */
  .posture-grid {
    margin-top: var(--ak-space-10);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--ak-space-6);
    scroll-margin-top: 5.5rem;
  }

  .posture-card {
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    padding: var(--ak-space-6);
    display: flex;
    flex-direction: column;
  }

  .posture-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ak-space-3);
    margin-bottom: var(--ak-space-3);
  }

  .posture-tag {
    font-size: var(--ak-text-xs);
    font-family: var(--ak-font-mono);
    font-weight: 600;
    color: hsl(var(--primary-accent));
    letter-spacing: var(--ak-tracking-wide);
  }

  .posture-pill {
    font-size: var(--ak-text-xs);
    font-family: var(--ak-font-mono);
    padding: 2px 8px;
    border-radius: var(--ak-radius-sm);
    background: hsl(var(--ak-neutral-800));
    color: hsl(var(--ak-neutral-200));
  }

  .posture-list {
    margin-top: var(--ak-space-4);
    display: flex;
    flex-direction: column;
    gap: var(--ak-space-3);
    list-style: none;
    padding: 0;
  }

  .posture-list li {
    font-size: var(--ak-text-sm);
    color: hsl(var(--ak-neutral-300));
    line-height: var(--ak-leading-relaxed);
  }

  .posture-list strong {
    color: hsl(var(--foreground));
    font-weight: 600;
  }

  .posture-list a {
    color: hsl(var(--primary-accent));
    font-weight: 500;
    margin-left: var(--ak-space-1);
  }

  .posture-list a:hover {
    text-decoration: underline;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .posture-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .why {
      padding: var(--ak-space-16) var(--ak-space-4);
    }
    .grid {
      grid-template-columns: 1fr;
      gap: var(--ak-space-4);
    }
  }
</style>
