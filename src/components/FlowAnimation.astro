---
import Icon from './Icon.astro';

const stages = [
  { id: 'agent-call', num: '01', label: 'AI Agent Call', sub: 'MCP JSON-RPC', icon: 'bot', cx: 115 },
  { id: 'policy-jcs', num: '02', label: 'Policy & JCS Hash', sub: 'RFC 8785 SHA-256', icon: 'shield-check', cx: 335 },
  { id: 'passkey-pulse', num: '03', label: 'Passkey Step-Up', sub: 'WebAuthn Proof', icon: 'fingerprint', cx: 555 },
  { id: 'vault-token', num: '04', label: 'Scoped Vault Token', sub: 'Single-Use Proof', icon: 'lock', cx: 765 },
];

const details: Record<string, { title: string; body: string }> = {
  'agent-call': {
    title: 'Intercept the call',
    body: 'The request is parsed and tied to the caller’s identity.',
  },
  'policy-jcs': {
    title: 'Canonicalize and check policy',
    body: 'The arguments are hashed (RFC 8785, SHA-256) and Cedar policy decides if the caller may proceed.',
  },
  'passkey-pulse': {
    title: 'Human approves the exact digest',
    body: 'A person approves exactly those arguments with a passkey.',
  },
  'vault-token': {
    title: 'Run with a short-lived token',
    body: 'The server spends the one-time approval and issues a short-lived token. The model never sees the real credential.',
  },
};
---
<section id="flow" class="flow" aria-labelledby="flow-heading">
  <div class="copy">
    <h2 id="flow-heading">Anatomy of a guarded tool call</h2>
    <p>Follow one high-stakes tool call from request to execution.</p>
  </div>

  <div class="stage">
    <div class="visual">
      <div class="diagram-frame">
        <svg
          class="diagram run"
          viewBox="0 0 880 210"
          role="img"
          aria-label="4-step MCP tool execution security pipeline"
          data-active-stage="agent-call"
        >
          <!-- Static background guide rails -->
          <g class="rails">
            <path class="rail rail-base" d="M115,105 L765,105" />
            <path class="rail" d="M115,105 L335,105" pathLength="1" />
            <path class="rail" d="M335,105 L555,105" pathLength="1" />
            <path class="rail" d="M555,105 L765,105" pathLength="1" />
          </g>

          <!-- Animated signal pulses -->
          <g class="pulses">
            <path class="pulse p-seg-1" d="M115,105 L335,105" pathLength="1" />
            <path class="pulse p-seg-2" d="M335,105 L555,105" pathLength="1" />
            <path class="pulse p-seg-3" d="M555,105 L765,105" pathLength="1" />
          </g>

          <!-- Dynamic traveling particles -->
          <g class="particles" aria-hidden="true">
            <circle class="flow-particle part-1" r="4.5" cy="105" />
            <circle class="flow-particle part-2" r="4.5" cy="105" />
            <circle class="flow-particle part-3" r="4.5" cy="105" />
          </g>

          <!-- Pipeline Nodes -->
          {stages.map((s, idx) => (
            <g class="stage-node" data-stage={s.id} transform={`translate(${s.cx}, 105)`}>
              <!-- Aura glow / Biometric wave rings -->
              <circle r="44" class="node-aura" />
              {s.id === 'passkey-pulse' && (
                <>
                  <circle r="36" class="biometric-pulse wave-1" />
                  <circle r="48" class="biometric-pulse wave-2" />
                </>
              )}

              <!-- Step pill badge -->
              <g transform="translate(0, -58)">
                <rect x="-34" y="-12" width="68" height="22" rx="11" class="step-pill" />
                <text x="0" y="3" class="step-text" text-anchor="middle">STEP {idx + 1}</text>
              </g>

              <!-- Node central chip -->
              <circle r="30" class="node-chip" />
              <g transform="translate(-11, -11)" class="node-glyph">
                <Icon name={s.icon} size={22} />
              </g>

              <!-- Legible Labels -->
              <text x="0" y="52" class="node-label" text-anchor="middle">{s.label}</text>
              <text x="0" y="70" class="node-sub" text-anchor="middle">{s.sub}</text>
            </g>
          ))}
        </svg>
      </div>

      <!-- 2x2 Step Selector Grid (Never orphans the 4th item) -->
      <ul class="legend" aria-label="Select ceremony step">
        {stages.map((s) => (
          <li data-stage={s.id} role="button" tabindex="0">
            <span class="legend-num">{s.num}</span>
            <Icon name={s.icon} size={16} class="legend-icon" aria-hidden="true" />
            <span class="legend-text">
              <strong class="legend-title">{s.label}</strong>
              <span class="legend-sub">{s.sub}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>

    <div class="detail-panel" aria-live="polite">
      {stages.map((s, idx) => (
        <div class:list={['detail', { off: idx !== 0 }]} data-detail={s.id}>
          <span class="detail-step">Step {idx + 1} of {stages.length}</span>
          <h3>{details[s.id].title}</h3>
          <p>{details[s.id].body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const svg = document.querySelector<SVGSVGElement>('#flow .diagram');
  const detailEls = document.querySelectorAll<HTMLElement>('#flow .detail[data-detail]');
  const legendItems = document.querySelectorAll<HTMLElement>('#flow .legend li');
  const stageNodes = document.querySelectorAll<SVGGElement>('#flow .stage-node');

  if (svg) {
    const stages = ['agent-call', 'policy-jcs', 'passkey-pulse', 'vault-token'];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;

    const setActive = (stageId: string) => {
      svg.setAttribute('data-active-stage', stageId);
      detailEls.forEach((el) => {
        el.classList.toggle('off', el.dataset.detail !== stageId);
      });
      legendItems.forEach((l) => l.classList.toggle('active', l.dataset.stage === stageId));
      stageNodes.forEach((node) => node.classList.toggle('active', node.dataset.stage === stageId));
    };

    const cycle = () => {
      setActive(stages[i]);
      i = (i + 1) % stages.length;
    };

    const selectStage = (stage: string | undefined) => {
      if (!stage) return;
      const idx = stages.indexOf(stage);
      if (idx !== -1) {
        i = idx;
        setActive(stage);
      }
    };

    legendItems.forEach((item) => {
      item.addEventListener('click', () => selectStage(item.dataset.stage));
      item.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          selectStage(item.dataset.stage);
        }
      });
    });

    stageNodes.forEach((node) => {
      node.addEventListener('click', () => selectStage(node.dataset.stage));
    });

    if (reduced) {
      setActive('policy-jcs');
    } else {
      cycle();
      setInterval(cycle, 4500);
    }
  }
</script>

<style>
  .flow {
    max-width: var(--ak-layout-max);
    margin: 0 auto;
    padding: 0 var(--ak-space-6) var(--ak-space-24);
  }

  .copy {
    max-width: 72ch;
    margin-bottom: var(--ak-space-10);
  }

  .copy h2 {
    font-size: var(--ak-text-3xl);
    letter-spacing: var(--ak-tracking-tight);
    color: hsl(var(--foreground));
  }

  .copy p {
    margin-top: var(--ak-space-4);
    color: hsl(var(--ak-neutral-300));
    font-size: var(--ak-text-lg);
    line-height: var(--ak-leading-relaxed);
  }

  .stage {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--ak-space-6);
    align-items: stretch;
  }

  .visual,
  .detail-panel {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .visual {
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--ak-radius-xl);
    padding: var(--ak-space-5);
    justify-content: space-between;
  }

  .diagram-frame {
    background: hsl(var(--ak-neutral-950));
    border: 1px solid hsl(var(--border));
    border-radius: var(--ak-radius-lg);
    padding: var(--ak-space-3) var(--ak-space-2);
  }

  .diagram {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Rails */
  .rail {
    fill: none;
    stroke: hsl(var(--border));
    stroke-width: 2;
  }

  .rail-base {
    stroke: hsl(var(--border) / 0.6);
    stroke-dasharray: 4 4;
  }

  /* Pulses */
  .pulse {
    fill: none;
    stroke: hsl(var(--primary-accent));
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 60 160;
    animation: dashLoop 2.4s linear infinite;
  }

  .p-seg-1 { animation-delay: 0s; }
  .p-seg-2 { animation-delay: 0.8s; }
  .p-seg-3 { animation-delay: 1.6s; }

  @keyframes dashLoop {
    0% {
      stroke-dashoffset: 220;
      opacity: 0.2;
    }
    30%, 70% {
      opacity: 1;
    }
    100% {
      stroke-dashoffset: -220;
      opacity: 0.2;
    }
  }

  /* Traveling Particles */
  .flow-particle {
    fill: hsl(var(--primary-accent));
    filter: drop-shadow(0 0 6px hsl(var(--primary-accent) / 0.8));
    animation: travelParticle 4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .part-1 { animation-delay: 0s; }
  .part-2 { animation-delay: 1.33s; }
  .part-3 { animation-delay: 2.66s; }

  @keyframes travelParticle {
    0% {
      cx: 115px;
      opacity: 0;
      r: 3px;
    }
    10% {
      opacity: 1;
      r: 5px;
    }
    90% {
      opacity: 1;
      r: 5px;
    }
    100% {
      cx: 765px;
      opacity: 0;
      r: 3px;
    }
  }

  /* Stage Nodes */
  .stage-node {
    transition: transform var(--ak-duration-fast) var(--ak-ease-out);
    cursor: pointer;
  }

  .node-aura {
    fill: hsl(var(--primary) / 0.08);
    stroke: hsl(var(--primary-accent) / 0.2);
    stroke-width: 1.5;
    transition: all var(--ak-duration-fast) var(--ak-ease-out);
  }

  .stage-node.active .node-aura {
    fill: hsl(var(--primary-subtle) / 0.45);
    stroke: hsl(var(--primary-accent) / 0.65);
    filter: drop-shadow(0 0 12px hsl(var(--primary-accent) / 0.35));
    animation: auraPulse 2s ease-in-out infinite;
  }

  @keyframes auraPulse {
    0%, 100% { r: 42px; opacity: 0.6; }
    50% { r: 46px; opacity: 1; }
  }

  /* Biometric wave */
  .biometric-pulse {
    fill: none;
    stroke: hsl(var(--primary-accent));
    stroke-width: 1.5;
    opacity: 0;
    animation: bioRadar 2.4s cubic-bezier(0.1, 0.7, 0.3, 1) infinite;
  }

  .wave-2 { animation-delay: 1.2s; }

  @keyframes bioRadar {
    0% {
      r: 30px;
      opacity: 0.8;
      stroke-width: 2px;
    }
    100% {
      r: 54px;
      opacity: 0;
      stroke-width: 0.5px;
    }
  }

  .step-pill {
    fill: hsl(var(--ak-neutral-800));
    stroke: hsl(var(--border));
    stroke-width: 1;
  }

  .step-text {
    font-size: 10.5px;
    font-family: var(--ak-font-mono);
    font-weight: 700;
    fill: hsl(var(--ak-neutral-300));
    letter-spacing: 0.05em;
  }

  .stage-node.active .step-pill {
    fill: hsl(var(--primary-subtle));
    stroke: hsl(var(--primary-accent));
  }

  .stage-node.active .step-text {
    fill: hsl(var(--primary-accent));
  }

  .node-chip {
    fill: hsl(var(--card));
    stroke: hsl(var(--border));
    stroke-width: 2;
    transition: all var(--ak-duration-fast) var(--ak-ease-out);
  }

  .stage-node.active .node-chip {
    fill: hsl(var(--primary-subtle));
    stroke: hsl(var(--primary-accent));
    stroke-width: 2.5;
  }

  .node-glyph {
    color: hsl(var(--ak-neutral-300));
    transition: color var(--ak-duration-fast) var(--ak-ease-out);
  }

  .stage-node.active .node-glyph {
    color: hsl(var(--primary-accent));
  }

  .node-label {
    font-size: 13px;
    font-family: var(--ak-font-sans);
    font-weight: 600;
    fill: hsl(var(--foreground));
  }

  .node-sub {
    font-size: 11px;
    font-family: var(--ak-font-mono);
    fill: hsl(var(--ak-neutral-300));
  }

  .stage-node.active .node-sub {
    fill: hsl(var(--primary-accent));
  }

  /* 2x2 Step Selector Grid */
  .legend {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--ak-space-3);
    margin-top: var(--ak-space-5);
    list-style: none;
    padding: 0;
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: var(--ak-space-3);
    padding: var(--ak-space-3) var(--ak-space-4);
    border-radius: var(--ak-radius-md);
    background: hsl(var(--ak-neutral-950));
    border: 1px solid hsl(var(--border));
    cursor: pointer;
    transition: all var(--ak-duration-fast) var(--ak-ease-out);
  }

  .legend li:hover {
    border-color: hsl(var(--input));
    background: hsl(var(--popover));
  }

  .legend li.active {
    border-color: hsl(var(--primary-accent));
    background: hsl(var(--primary-subtle) / 0.35);
  }

  .legend-num {
    font-size: var(--ak-text-xs);
    font-family: var(--ak-font-mono);
    font-weight: 600;
    color: hsl(var(--muted-foreground));
  }

  .legend li.active .legend-num,
  .legend li.active .legend-icon {
    color: hsl(var(--primary-accent));
  }

  .legend-icon {
    color: hsl(var(--ak-neutral-300));
    flex-shrink: 0;
  }

  .legend-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .legend-title {
    font-size: var(--ak-text-sm);
    font-weight: 600;
    color: hsl(var(--foreground));
    line-height: var(--ak-leading-snug);
  }

  .legend-sub {
    font-size: var(--ak-text-xs);
    font-family: var(--ak-font-mono);
    color: hsl(var(--muted-foreground));
  }

  /* Step detail panel */
  .detail-panel {
    display: grid;
    align-content: center;
    padding: var(--ak-space-8);
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--ak-radius-xl);
  }

  .detail {
    grid-area: 1 / 1;
  }

  .detail.off {
    visibility: hidden;
  }

  .detail-step {
    font-size: var(--ak-text-xs);
    font-family: var(--ak-font-mono);
    color: hsl(var(--primary-accent));
  }

  .detail h3 {
    margin-top: var(--ak-space-3);
    font-size: var(--ak-text-xl);
  }

  .detail p {
    margin-top: var(--ak-space-3);
    color: hsl(var(--ak-neutral-300));
    line-height: var(--ak-leading-relaxed);
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse {
      stroke-dashoffset: 0 !important;
      opacity: 0.8 !important;
      animation: none !important;
    }
    .flow-particle {
      display: none !important;
    }
    .node-aura,
    .biometric-pulse {
      animation: none !important;
    }
    .stage-node.active .node-aura {
      opacity: 0.8 !important;
    }
  }

  @media (max-width: 960px) {
    .stage {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .flow {
      padding: 0 var(--ak-space-4) var(--ak-space-16);
    }
    .copy h2 {
      font-size: var(--ak-text-2xl);
    }
    .copy p {
      font-size: var(--ak-text-base);
    }
    .visual { padding: var(--ak-space-4); }
    /* The 880px-wide SVG is unreadable on phones; the step selector replaces it. */
    .diagram-frame {
      display: none;
    }
    .legend {
      margin-top: 0;
      grid-template-columns: 1fr;
    }
    .detail-panel {
      padding: var(--ak-space-5);
    }
  }
</style>
