---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Authkestra — Your security can't be hallucinated | Compile-Time Safe Identity & AI Agent Authorization for Rust",
  description = 'Compile-time safe OAuth 2.1, OIDC Provider, Passkeys, AWS Cedar policy, and production Model Context Protocol (MCP) agent security in a single embedded Rust engine.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://authkestra.com');
const ogImageURL = new URL('/og-card.png', Astro.site || 'https://authkestra.com');

const faqQuestions = [
  {
    q: 'How does authkestra-mcp secure AI agents and Model Context Protocol servers?',
    a: 'authkestra-mcp provides a 3-tier security architecture for MCP JSON-RPC tools: Tier 1 (Public) for unauthenticated queries; Tier 2 (Scoped) requiring OAuth 2.1 bearer tokens with RFC 9728 discovery and DPoP binding; and Tier 3 (HumanApproved) requiring cryptographic step-up approval. Furthermore, the DownstreamTokenBroker safely resolves third-party API credentials without exposing refresh tokens or long-lived secrets in the LLM context window.',
  },
  {
    q: 'How does Authkestra prevent AI agents from tampering with approved tool parameters?',
    a: 'When a tool requires Human-in-the-Loop step-up approval, Authkestra applies RFC 8785 JSON Canonicalization Scheme (JCS) to the tool\'s arguments and computes a deterministic SHA-256 challenge digest over (session_id, tool_name, jcs_arguments, expires_at). If an AI agent or malicious actor alters even a single parameter value or order before execution, the cryptographic digest check fails, rejecting execution with a parameter mismatch error.',
  },
  {
    q: 'How do AI coding assistants discover Authkestra APIs via llms.txt and Claude skills?',
    a: 'Authkestra publishes machine-readable API summaries at https://authkestra.com/llms.txt and comprehensive documentation at https://docs.authkestra.com/llms-full.txt. Additionally, the official Authkestra/skills repository provides structured Claude Code / agent skills that teach AI assistants exact typestate builder constraints, Cargo feature flags, and store implementations.',
  },
  {
    q: 'What is Re-Proof Gating and how does it prevent session escalation?',
    a: 'In many web applications, an attacker who steals an active session cookie can immediately register a new passkey or TOTP authenticator to lock out the genuine owner. Authkestra enforces Re-Proof Gating: registering high-stakes authenticators requires verifying an existing primary factor (ReproofRequirement::FreshPasskey or ReproofRequirement::FreshPassword) within a strict time window, closing the session-hijack-then-enrol vulnerability.',
  },
  {
    q: 'When should I choose an embedded engine like Authkestra vs. Keycloak, Ory, or Zitadel?',
    a: 'Choose Authkestra when you are building Rust services or MCP servers and want in-process OAuth 2.1, Passkeys, Cedar policy, and agent tool guards with zero network hops or extra sidecar clusters. Choose a standalone IdP (Keycloak, Zitadel, Ory) if you need a turnkey admin GUI for non-technical operators, legacy SAML 2.0 federation, or a central workforce SSO portal across many non-Rust languages—you can also connect Authkestra to them via OIDC discovery.',
  },
  {
    q: 'How does Stateless OAuth work without storing sessions in a database?',
    a: 'Authkestra encapsulates OAuth2 authorization state and PKCE code verifiers inside AES-256-GCM encrypted, authenticated cookies (__Host-authkestra_state). The browser holds the encrypted state during the OAuth redirect dance. Upon callback, the engine verifies the authentication tag and decrypts the state in memory, allowing your application to scale horizontally across servers without a shared Redis or SQL session store.',
  },
  {
    q: 'Can I use Authkestra with any database or web framework?',
    a: 'Yes. Authkestra\'s engine core is pure Rust logic with zero framework dependencies. First-party adapters exist for Axum (authkestra-axum) and Actix-web (authkestra-actix). Persistence is defined via traits (KvStore, SessionStore, CredentialStore, OpStore). We provide built-in in-memory, Redis, and SQL (PostgreSQL, MySQL, SQLite) implementations, or you can implement the traits for your custom data store.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareSourceCode',
      '@id': 'https://authkestra.com/#software',
      name: 'Authkestra',
      description: 'The Compile-Time Safe Identity & AI Agent Authorization Engine for Rust',
      url: 'https://authkestra.com',
      programmingLanguage: 'Rust',
      runtimePlatform: 'Rust 2021 Edition',
      codeRepository: 'https://github.com/Authkestra/authkestra',
      license: 'https://github.com/Authkestra/authkestra/blob/main/LICENSE-MIT',
      applicationCategory: 'SecurityApplication',
      operatingSystem: 'Cross-platform (Linux, macOS, Windows)',
      author: {
        '@id': 'https://authkestra.com/#organization',
      },
    },
    {
      '@type': 'Organization',
      '@id': 'https://authkestra.com/#organization',
      name: 'Authkestra',
      url: 'https://authkestra.com',
      logo: 'https://authkestra.com/icon-512.png',
      sameAs: [
        'https://github.com/Authkestra',
        'https://crates.io/crates/authkestra',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://authkestra.com/#website',
      name: 'Authkestra',
      url: 'https://authkestra.com',
      description: 'The Compile-Time Safe Identity & AI Agent Authorization Engine for Rust',
      publisher: {
        '@id': 'https://authkestra.com/#organization',
      },
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://authkestra.com/#faq',
      mainEntity: faqQuestions.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a,
        },
      })),
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="rust, authentication, authorization, oauth2, openid-connect, passkeys, webauthn, mcp, model-context-protocol, ai-agents, zero-trust, axum, actix-web, cedar-policy, security" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- OpenGraph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Authkestra" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Authkestra — The Compile-Time Safe Identity & AI Agent Authorization Engine for Rust" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="Authkestra — The Compile-Time Safe Identity & AI Agent Authorization Engine for Rust" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />
  </body>
</html>
