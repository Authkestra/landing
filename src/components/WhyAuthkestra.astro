---
import Icon from './Icon.astro';

const cards = [
  {
    icon: 'bot',
    title: 'AI Agent & MCP Tool Authorization',
    body: 'Native 3-tier security for Model Context Protocol tools, complete with RFC 8785 JCS parameter binding, Passkey step-up approvals, and a zero-trust downstream token vault.',
  },
  {
    icon: 'shield',
    title: 'Typestate Compile-Time Safety',
    body: 'The typestate builder pattern turns a misconfigured engine into a compiler error, not a 2am runtime panic. Missing stores or omitting CSRF middleware simply will not compile.',
  },
  {
    icon: 'feather',
    title: 'Stateless OAuth & Zero DB Dependency',
    body: 'State and nonce live in AES-256-GCM encrypted cookies, never your database — allowing horizontal scaling across instances without requiring a shared Redis or SQL session store.',
  },
  {
    icon: 'server',
    title: 'Tri-Role OAuth 2.1 Engine',
    body: 'Play OpenID Provider (OP), Client (RP), and Resource Server (RS) from a single crate. Protect APIs with RFC 9449 DPoP and RFC 8705 mTLS proof-of-possession token binding.',
  },
  {
    icon: 'route',
    title: 'Fine-Grained Cedar Policy & CAEP',
    body: 'Evaluate declarative AWS Cedar authorization policies in microseconds, and ingest OpenID Shared Signals and Events (CAEP/SSF) to revoke compromised sessions continuously.',
  },
  {
    icon: 'puzzle',
    title: 'Framework & Database Agnostic',
    body: 'The core engine is pure Rust logic. Axum and Actix-web are lightweight isolated adapters, and storage is a trait you implement — no relational schema is ever forced upon your database.',
  },
];
---
<section id="why" class="why" aria-labelledby="why-heading">
  <div class="inner">
    <h2 id="why-heading">Why Authkestra</h2>
    <p class="lead">
      Built from the ground up for teams who demand cryptographic rigor, compile-time
      correctness, and zero operational baggage — both in backend web APIs and autonomous AI systems.
    </p>
    <div class="grid">
      {cards.map((c) => (
        <div class="card">
          <div class="card-icon-wrap">
            <Icon name={c.icon} size={28} class="card-icon" aria-hidden="true" />
          </div>
          <h3>{c.title}</h3>
          <p>{c.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why {
    max-width: var(--ak-layout-max);
    margin: 0 auto;
    padding: var(--ak-space-24) var(--ak-space-6);
  }

  .inner {
    position: relative;
  }

  h2 {
    font-size: var(--ak-text-3xl);
    letter-spacing: var(--ak-tracking-tight);
  }

  .lead {
    margin-top: var(--ak-space-4);
    max-width: 64ch;
    font-size: var(--ak-text-lg);
    color: hsl(var(--muted-foreground));
    line-height: var(--ak-leading-relaxed);
  }

  .grid {
    margin-top: var(--ak-space-12);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--ak-space-6);
  }

  .card {
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    padding: var(--ak-space-6);
    transition: border-color var(--ak-duration-fast) var(--ak-ease-out);
  }

  .card:hover {
    border-color: hsl(var(--input));
  }

  .card-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--ak-radius-md);
    background: hsl(var(--ak-neutral-800));
    color: hsl(var(--primary-accent));
    margin-bottom: var(--ak-space-4);
  }

  h3 {
    font-size: var(--ak-text-lg);
    font-weight: 600;
    color: hsl(var(--foreground));
  }

  .card p {
    margin-top: var(--ak-space-3);
    font-size: var(--ak-text-sm);
    color: hsl(var(--muted-foreground));
    line-height: var(--ak-leading-relaxed);
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .why {
      padding: var(--ak-space-16) var(--ak-space-4);
    }
    .grid {
      grid-template-columns: 1fr;
      gap: var(--ak-space-4);
    }
  }
</style>
