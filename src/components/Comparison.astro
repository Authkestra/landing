---
import Icon from './Icon.astro';

// A "yes" cell: paired icon + word, never colour alone (DESIGN.md §2, §8).
const yes = (label: string) => ({ kind: 'yes' as const, label });
const plain = (label: string) => ({ kind: 'plain' as const, label });
const muted = (label: string) => ({ kind: 'muted' as const, label });

const rows = [
  {
    feature: 'Category',
    authkestra: plain('Embedded identity & AI agent engine'),
    embeddedAlt: plain('Embedded auth library'),
    standalone: plain('Standalone IdP microservice'),
  },
  {
    feature: 'OAuth2 / OIDC role',
    authkestra: yes('Provider, client, and resource server — one crate'),
    embeddedAlt: muted('Relying party (client) only'),
    standalone: yes('Full provider (OP) support'),
  },
  {
    feature: 'AI Agent & MCP Tool Security',
    authkestra: yes('Native — 3-tier security, RFC 8785 JCS binding, Downstream Vault'),
    embeddedAlt: muted('Not offered'),
    standalone: muted('Not offered'),
  },
  {
    feature: 'Resource server & token binding',
    authkestra: yes('Native — DPoP (RFC 9449) & mTLS (RFC 8705) binding'),
    embeddedAlt: muted('Not offered'),
    standalone: plain('API token validation'),
  },
  {
    feature: 'Configuration & codegen safety',
    authkestra: yes('Strict — compile-time typestate builder (zero runtime panic)'),
    embeddedAlt: muted('Runtime builder errors'),
    standalone: muted('N/A — external config files'),
  },
  {
    feature: 'State management',
    authkestra: plain('Stateless, AES-256-GCM encrypted cookies'),
    embeddedAlt: plain('Stateful — Redis or in-memory store'),
    standalone: plain('Stateful, dedicated DB cluster'),
  },
  {
    feature: 'Data architecture',
    authkestra: plain('Agnostic, trait-based — any DB (Postgres, MySQL, SQLite, custom)'),
    embeddedAlt: plain('SQLite / PostgreSQL built in'),
    standalone: plain('Mandatory internal database'),
  },
  {
    feature: 'Policy engine (ABAC)',
    authkestra: yes('AWS Cedar policy engine integrated directly into the binary'),
    embeddedAlt: muted('Not offered'),
    standalone: plain('Internal RBAC / group permissions'),
  },
  {
    feature: 'Continuous access evaluation',
    authkestra: yes('OpenID CAEP / SSF (RFC 8417) security event token receiver'),
    embeddedAlt: muted('Not offered'),
    standalone: plain('Proprietary session kill'),
  },
  {
    feature: 'Passwordless methods',
    authkestra: yes('5 — Passkeys, TOTP, Magic link, Email/SMS OTP, Recovery codes'),
    embeddedAlt: yes('Passkeys (WebAuthn)'),
    standalone: yes('Passkeys, plus standard MFA'),
  },
  {
    feature: 'Re-Proof enrolment gating',
    authkestra: yes('Required — closes the session-hijack-then-enrol gap'),
    embeddedAlt: muted('Not documented'),
    standalone: muted('Not documented'),
  },
];
---
<section id="comparison" class="comparison" aria-labelledby="comparison-heading">
  <div class="inner">
    <h2 id="comparison-heading">Authkestra vs. Alternative Approaches</h2>
    <p class="lead">
      In the Rust ecosystem you generally choose between a standalone identity
      provider microservice and a lightweight embedded library. Authkestra combines the best of both:
      a modular identity and AI authorization engine, embedded directly in your binary, that plays
      all three OAuth 2.1 roles and secures AI agent tool execution with zero network latency.
    </p>

    <div class="table-scroll">
      <table>
        <caption class="visually-hidden">
          Feature comparison between Authkestra, oauth2-passkey, and standalone servers Rauthy and Kanidm
        </caption>
        <thead>
          <tr>
            <th scope="col">Feature</th>
            <th scope="col" class="col-ak">Authkestra</th>
            <th scope="col">oauth2-passkey</th>
            <th scope="col">Rauthy / Kanidm</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <th scope="row">{r.feature}</th>
              {[r.authkestra, r.embeddedAlt, r.standalone].map((cell, i) => (
                <td class:list={[{ 'col-ak': i === 0 }]}>
                  {cell.kind === 'yes' && (
                    <span class="verdict yes">
                      <Icon name="circle-check" size={16} aria-hidden="true" />
                      {cell.label}
                    </span>
                  )}
                  {cell.kind === 'muted' && <span class="verdict muted">{cell.label}</span>}
                  {cell.kind === 'plain' && <span class="verdict plain">{cell.label}</span>}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="detail">
      <div class="detail-card">
        <h3>vs. oauth2-passkey</h3>
        <p>
          A clean, focused library for signing users in with Google-style OAuth2 and passkeys, backed
          by its own Redis/SQL session store. However, it is strictly a relying party: there is no OpenID
          Provider to issue tokens for your internal services, no Resource Server middleware to validate
          incoming tokens with DPoP, and no AI/MCP tool security. Authkestra plays all three OAuth roles
          plus full Model Context Protocol security from one cohesive crate.
        </p>
      </div>
      <div class="detail-card">
        <h3>vs. Rauthy &amp; Kanidm</h3>
        <p>
          Both are excellent standalone Rust identity servers — the right call when your architecture
          mandates a dedicated IdP microservice cluster. Authkestra gives you the same enterprise OpenID
          Provider capabilities without the extra service to deploy, the network hop, or the dedicated database
          to operate — plus a complete Resource Server SDK and OIDC client for your own application logic.
        </p>
      </div>
      <div class="detail-card">
        <h3>vs. Cloud &amp; Sidecar IdPs (Keycloak / Ory / Zitadel)</h3>
        <p>
          External sidecars force every authorization check across a network boundary and require managing
          separate containers and synchronization pipelines. Authkestra runs in-process inside your Rust
          binary: token validation, Cedar policy evaluation, and MCP step-up challenges happen in microseconds
          with complete memory safety and zero network latency.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .comparison {
    max-width: var(--ak-layout-max);
    margin: 0 auto;
    padding: var(--ak-space-24) var(--ak-space-6);
  }

  .inner {
    position: relative;
  }

  h2 {
    font-size: var(--ak-text-3xl);
    letter-spacing: var(--ak-tracking-tight);
    color: hsl(var(--foreground));
  }

  .lead {
    margin-top: var(--ak-space-4);
    max-width: var(--ak-layout-prose);
    font-size: var(--ak-text-lg);
    line-height: var(--ak-leading-relaxed);
    color: hsl(var(--muted-foreground));
  }

  .table-scroll {
    margin-top: var(--ak-space-12);
    overflow-x: auto;
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    background: hsl(var(--card));
  }

  table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: var(--ak-text-sm);
  }

  th, td {
    text-align: left;
    padding: var(--ak-space-3) var(--ak-space-4);
    border-bottom: 1px solid hsl(var(--border));
    white-space: normal;
  }

  thead th {
    color: hsl(var(--foreground));
    font-weight: 600;
    background: hsl(var(--popover));
  }

  tbody th {
    color: hsl(var(--foreground));
    font-weight: 500;
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: none;
  }

  .verdict {
    display: inline-flex;
    align-items: flex-start;
    gap: var(--ak-space-2);
    line-height: var(--ak-leading-snug);
  }

  .verdict.yes {
    color: hsl(var(--success-foreground));
  }

  .verdict.yes :global(svg) {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .verdict.muted {
    color: hsl(var(--muted-foreground) / 0.75);
  }

  .col-ak {
    background: hsl(var(--primary-subtle) / 0.55);
  }

  thead .col-ak {
    color: hsl(var(--primary-accent));
  }

  .col-ak .verdict.plain {
    color: hsl(var(--primary-accent));
  }

  .verdict.plain {
    color: hsl(var(--muted-foreground));
  }

  .detail {
    margin-top: var(--ak-space-12);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--ak-space-6);
  }

  .detail-card {
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    padding: var(--ak-space-6);
  }

  .detail h3 {
    font-size: var(--ak-text-base);
    font-weight: 600;
    color: hsl(var(--foreground));
  }

  .detail p {
    margin-top: var(--ak-space-2);
    font-size: var(--ak-text-xs);
    line-height: var(--ak-leading-normal);
    color: hsl(var(--muted-foreground));
  }

  @media (max-width: 960px) {
    .detail {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .comparison {
      padding: var(--ak-space-16) var(--ak-space-4);
    }
  }
</style>
