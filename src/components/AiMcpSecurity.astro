---
import Icon from './Icon.astro';

const tiers = [
  {
    name: 'Public',
    icon: 'circle-check',
    diagram: 'tier1',
    desc: 'Read-only tools anyone can call. Caller identity is attached when present.',
  },
  {
    name: 'Scoped',
    icon: 'shield-check',
    diagram: 'tier2',
    desc: 'Needs an OAuth 2.1 token with the right scopes, sender-bound with DPoP or mTLS.',
  },
  {
    name: 'Human-approved',
    icon: 'key',
    diagram: 'tier3',
    desc: 'A person approves the exact arguments with a passkey before the tool runs.',
  },
];

const guarantees = [
  {
    icon: 'shield-alert',
    title: 'Arguments can’t drift',
    body: 'Approval is tied to a hash of the exact arguments. Change one value and the call fails.',
  },
  {
    icon: 'lock',
    title: 'Secrets never reach the model',
    body: 'API keys and refresh tokens stay in an encrypted server-side vault.',
  },
  {
    icon: 'square-function',
    title: 'Miswiring fails to compile',
    body: 'A missing store or validator is a build error, not a production panic.',
  },
];
---
<section id="ai-mcp-security" class="ai-mcp" aria-labelledby="ai-mcp-heading">
  <span id="ai-agents-mcp" class="anchor-alias" aria-hidden="true"></span>
  <div class="inner">
    <div class="header">
      <h2 id="ai-mcp-heading">Give AI agents tools, not secrets</h2>
      <p class="lead">
        authkestra-mcp puts every MCP tool call behind one of three security tiers.
      </p>
    </div>

    <div class="tiers-grid">
      {tiers.map((t) => (
        <div class="tier-card">
          <div class="tier-diagram-wrap">
            {t.diagram === 'tier1' && (
              <svg class="tier-diagram svg-tier-1" viewBox="0 0 320 116" role="img" aria-label="Tier 1 Public Tool Conduit">
                <path class="t-rail" d="M44,56 L276,56" />
                <path class="t-stream stream-tier-1" d="M44,56 L276,56" />
                <path class="t-tap" d="M160,26 L160,56" />
                <circle cx="160" cy="26" r="5" class="t-tap-dot" />
                <text x="160" y="16" class="t-diagram-caption" text-anchor="middle">Context Tap</text>

                <circle class="t-particle t-p1" r="4" cy="56" />
                <circle class="t-particle t-p2" r="4" cy="56" />

                <g transform="translate(44, 56)">
                  <circle r="20" class="t-node-chip" />
                  <text x="0" y="4" class="t-node-glyph" text-anchor="middle">Agent</text>
                  <text x="0" y="34" class="t-diagram-sub" text-anchor="middle">Caller</text>
                </g>
                <g transform="translate(276, 56)">
                  <circle r="20" class="t-node-chip t-node-success" />
                  <text x="0" y="4" class="t-node-glyph t-glyph-success" text-anchor="middle">Tool</text>
                  <text x="0" y="34" class="t-diagram-sub" text-anchor="middle">Public</text>
                </g>
              </svg>
            )}
            {t.diagram === 'tier2' && (
              <svg class="tier-diagram svg-tier-2" viewBox="0 0 320 116" role="img" aria-label="Tier 2 Scoped Resource Guard">
                <path class="t-rail" d="M44,56 L134,56" />
                <path class="t-rail" d="M186,56 L276,56" />
                <path class="t-stream stream-tier-2" d="M186,56 L276,56" />

                <g class="t-gate" transform="translate(160, 56)">
                  <circle r="24" class="t-gate-aura" />
                  <rect x="-24" y="-14" width="48" height="28" rx="6" class="t-shield" />
                  <text x="0" y="4" class="t-gate-text" text-anchor="middle">DPoP</text>
                  <text x="0" y="34" class="t-diagram-sub" text-anchor="middle">Scope Check</text>
                </g>

                <circle class="t-particle t-p-scoped-in" r="4" cy="56" />
                <circle class="t-particle t-p-scoped-out" r="4" cy="56" />

                <g transform="translate(44, 56)">
                  <circle r="20" class="t-node-chip" />
                  <text x="0" y="4" class="t-node-glyph" text-anchor="middle">Token</text>
                  <text x="0" y="34" class="t-diagram-sub" text-anchor="middle">OAuth 2.1</text>
                </g>
                <g transform="translate(276, 56)">
                  <circle r="20" class="t-node-chip t-node-success" />
                  <text x="0" y="4" class="t-node-glyph t-glyph-success" text-anchor="middle">Tool</text>
                  <text x="0" y="34" class="t-diagram-sub" text-anchor="middle">Scoped</text>
                </g>
              </svg>
            )}
            {t.diagram === 'tier3' && (
              <svg class="tier-diagram svg-tier-3" viewBox="0 0 320 116" role="img" aria-label="Tier 3 Human-Approved Step-Up">
                <path class="t-rail" d="M42,56 L92,56" />
                <path class="t-rail t-rail-bridge" d="M138,56 L182,56" />
                <path class="t-stream stream-tier-3" d="M228,56 L278,56" />

                <g class="t-lock-node" transform="translate(115, 56)">
                  <rect x="-21" y="-14" width="42" height="28" rx="6" class="t-lock-body" />
                  <text x="0" y="4" class="t-lock-label" text-anchor="middle">JCS</text>
                  <text x="0" y="34" class="t-diagram-sub" text-anchor="middle">SHA-256</text>
                </g>

                <g class="t-bio-node" transform="translate(205, 56)">
                  <circle r="23" class="t-bio-wave wave-a" />
                  <circle r="32" class="t-bio-wave wave-b" />
                  <circle r="20" class="t-bio-chip" />
                  <text x="0" y="4" class="t-bio-glyph" text-anchor="middle">FIDO2</text>
                  <text x="0" y="34" class="t-diagram-sub" text-anchor="middle">Passkey</text>
                </g>

                <g transform="translate(42, 56)">
                  <circle r="20" class="t-node-chip" />
                  <text x="0" y="4" class="t-node-glyph" text-anchor="middle">Agent</text>
                  <text x="0" y="34" class="t-diagram-sub" text-anchor="middle">Call</text>
                </g>
                <g transform="translate(278, 56)">
                  <circle r="20" class="t-node-chip t-node-success" />
                  <text x="0" y="4" class="t-node-glyph t-glyph-success" text-anchor="middle">Exec</text>
                  <text x="0" y="34" class="t-diagram-sub" text-anchor="middle">Verified</text>
                </g>
              </svg>
            )}
          </div>
          <h3>{t.name}</h3>
          <p class="tier-desc">{t.desc}</p>
        </div>
      ))}
    </div>

    <ul class="guarantees">
      {guarantees.map((g) => (
        <li>
          <Icon name={g.icon} size={20} class="g-icon" aria-hidden="true" />
          <div>
            <h3>{g.title}</h3>
            <p>{g.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .ai-mcp {
    max-width: var(--ak-layout-max);
    margin: 0 auto;
    padding: var(--ak-space-24) var(--ak-space-6);
    position: relative;
  }

  .anchor-alias {
    position: absolute;
    top: 0;
    left: 0;
    visibility: hidden;
  }

  .inner {
    position: relative;
  }

  .header {
    max-width: 72ch;
  }

  h2 {
    font-size: var(--ak-text-3xl);
    letter-spacing: var(--ak-tracking-tight);
    color: hsl(var(--foreground));
  }

  .lead {
    margin-top: var(--ak-space-4);
    font-size: var(--ak-text-lg);
    line-height: var(--ak-leading-relaxed);
    color: hsl(var(--ak-neutral-300));
  }

  /* Tiers Grid */
  .tiers-grid {
    margin-top: var(--ak-space-12);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--ak-space-6);
    align-items: stretch;
  }

  .tier-card {
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    padding: var(--ak-space-6);
    display: flex;
    flex-direction: column;
    transition: border-color var(--ak-duration-fast) var(--ak-ease-out);
  }

  .tier-card:hover {
    border-color: hsl(var(--input));
  }

  .tier-card h3 {
    font-size: var(--ak-text-lg);
    font-weight: 600;
    color: hsl(var(--foreground));
  }

  /* 2D Animated Diagram Wrappers */
  .tier-diagram-wrap {
    margin-bottom: var(--ak-space-5);
    background: hsl(var(--ak-neutral-950));
    border: 1px solid hsl(var(--border));
    border-radius: var(--ak-radius-md);
    padding: var(--ak-space-3);
    overflow: hidden;
  }

  .tier-diagram {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Shared SVG Diagram Styles (Scaled up to 10.5px-11.5px for clear legibility) */
  .t-rail {
    fill: none;
    stroke: hsl(var(--border));
    stroke-width: 2;
  }

  .t-stream {
    fill: none;
    stroke: hsl(var(--primary-accent));
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 40 80;
    animation: tierStreamFlow 2.5s linear infinite;
  }

  @keyframes tierStreamFlow {
    0% { stroke-dashoffset: 120; opacity: 0.3; }
    50% { opacity: 1; }
    100% { stroke-dashoffset: -120; opacity: 0.3; }
  }

  .t-tap {
    stroke: hsl(var(--primary) / 0.7);
    stroke-width: 1.5;
    stroke-dasharray: 2 3;
  }

  .t-tap-dot {
    fill: hsl(var(--primary-accent));
  }

  .t-diagram-caption {
    font-size: 11px;
    font-family: var(--ak-font-mono);
    fill: hsl(var(--primary-accent));
    font-weight: 600;
  }

  .t-diagram-sub {
    font-size: 10.5px;
    font-family: var(--ak-font-mono);
    fill: hsl(var(--ak-neutral-300));
  }

  .t-node-chip {
    fill: hsl(var(--card));
    stroke: hsl(var(--input));
    stroke-width: 1.5;
  }

  .t-node-success {
    stroke: hsl(var(--success-foreground));
    fill: hsl(var(--primary-subtle) / 0.5);
  }

  .t-node-glyph {
    font-size: 10.5px;
    font-family: var(--ak-font-mono);
    font-weight: 700;
    fill: hsl(var(--foreground));
  }

  .t-glyph-success {
    fill: hsl(var(--success-foreground));
  }

  .t-particle {
    fill: hsl(var(--primary-accent));
    filter: drop-shadow(0 0 4px hsl(var(--primary-accent) / 0.8));
    animation: particleTravel 2.4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .t-p1 { animation-delay: 0s; }
  .t-p2 { animation-delay: 1.2s; }

  @keyframes particleTravel {
    0% { cx: 44px; opacity: 0; }
    15% { opacity: 1; }
    85% { opacity: 1; }
    100% { cx: 276px; opacity: 0; }
  }

  /* Tier 2 Gate Shield */
  .t-gate-aura {
    fill: hsl(var(--primary-subtle) / 0.4);
    stroke: hsl(var(--primary-accent) / 0.5);
    stroke-width: 1.5;
    animation: gatePulse 2s ease-in-out infinite;
  }

  @keyframes gatePulse {
    0%, 100% { r: 22px; opacity: 0.5; }
    50% { r: 26px; opacity: 1; }
  }

  .t-shield {
    fill: hsl(var(--card));
    stroke: hsl(var(--primary-accent));
    stroke-width: 1.5;
  }

  .t-gate-text {
    font-size: 11px;
    font-family: var(--ak-font-mono);
    font-weight: 700;
    fill: hsl(var(--primary-accent));
  }

  .t-p-scoped-in {
    animation: particleScopedIn 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .t-p-scoped-out {
    animation: particleScopedOut 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    animation-delay: 1s;
  }

  @keyframes particleScopedIn {
    0% { cx: 44px; opacity: 0; }
    20% { opacity: 1; }
    90% { opacity: 1; }
    100% { cx: 134px; opacity: 0; }
  }

  @keyframes particleScopedOut {
    0% { cx: 186px; opacity: 0; }
    20% { opacity: 1; }
    90% { opacity: 1; }
    100% { cx: 276px; opacity: 0; }
  }

  /* Tier 3 JCS Lock and Biometrics */
  .t-lock-body {
    fill: hsl(var(--ak-neutral-800));
    stroke: hsl(var(--primary-accent));
    stroke-width: 1.5;
  }

  .t-lock-label {
    font-size: 11px;
    font-family: var(--ak-font-mono);
    font-weight: 700;
    fill: hsl(var(--primary-accent));
  }

  .t-bio-chip {
    fill: hsl(var(--card));
    stroke: hsl(var(--primary-accent));
    stroke-width: 1.5;
  }

  .t-bio-glyph {
    font-size: 10px;
    font-family: var(--ak-font-mono);
    font-weight: 700;
    fill: hsl(var(--primary-accent));
  }

  .t-bio-wave {
    fill: none;
    stroke: hsl(var(--primary-accent));
    stroke-width: 1.2;
    opacity: 0;
    animation: bioPulseWave 2.4s cubic-bezier(0.1, 0.7, 0.3, 1) infinite;
  }

  .wave-b { animation-delay: 1.2s; }

  @keyframes bioPulseWave {
    0% { r: 20px; opacity: 0.9; stroke-width: 1.5px; }
    100% { r: 36px; opacity: 0; stroke-width: 0.5px; }
  }

  .t-rail-bridge {
    stroke: hsl(var(--primary-accent) / 0.5);
    stroke-dasharray: 3 3;
  }

  .tier-desc {
    font-size: var(--ak-text-sm);
    color: hsl(var(--ak-neutral-300));
    line-height: var(--ak-leading-relaxed);
    margin-top: var(--ak-space-2);
  }

  /* Accessibility: prefers-reduced-motion */
  .guarantees {
    margin-top: var(--ak-space-12);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--ak-space-8);
    padding-top: var(--ak-space-8);
    border-top: 1px solid hsl(var(--border));
  }

  .guarantees li {
    display: flex;
    gap: var(--ak-space-4);
    align-items: flex-start;
  }

  .guarantees :global(.g-icon) {
    flex-shrink: 0;
    margin-top: 2px;
    color: hsl(var(--primary-accent));
  }

  .guarantees h3 {
    font-size: var(--ak-text-base);
    font-weight: 600;
  }

  .guarantees p {
    margin-top: var(--ak-space-1);
    font-size: var(--ak-text-sm);
    color: hsl(var(--ak-neutral-300));
    line-height: var(--ak-leading-normal);
  }

  .tier-card h3 { margin-top: 0; }

  @media (prefers-reduced-motion: reduce) {
    .t-stream,
    .lane-stream {
      stroke-dashoffset: 0 !important;
      opacity: 0.8 !important;
      animation: none !important;
    }
    .t-particle,
    .lane-particle {
      display: none !important;
    }
    .t-gate-aura,
    .t-bio-wave {
      animation: none !important;
      opacity: 0.7 !important;
    }
  }

  @media (max-width: 960px) {
    .tiers-grid,
    .guarantees {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .ai-mcp {
      padding: var(--ak-space-16) var(--ak-space-4);
    }
  }
</style>
