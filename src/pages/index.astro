---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import AiMcpSecurity from '../components/AiMcpSecurity.astro';
import FlowAnimation from '../components/FlowAnimation.astro';
import Quickstart from '../components/Quickstart.astro';
import Capabilities from '../components/Capabilities.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---
<Layout
  title="Authkestra — Your security can't be hallucinated | Compile-Time Safe Identity & AI Agent Authorization for Rust"
  description="Compile-time safe OAuth 2.1, OIDC Provider, Passkeys, AWS Cedar policy, and production Model Context Protocol (MCP) agent security in a single embedded Rust engine."
>
  <Nav />
  <main>
    <Hero />
    <AiMcpSecurity />
    <FlowAnimation />
    <Quickstart />
    <Capabilities />
    <Faq />
  </main>
  <Footer />
</Layout>
